---
import ReviewCard from "./ReviewCard.astro";
import {
  CATEGORIES,
  aggregate,
  categoryCounts,
  formatRange,
  reviewsFor,
  type CategorySlug,
} from "@/lib/reviews";

interface Props {
  /** null renders every category. */
  category: CategorySlug | null;
  heading: string;
  blurb: string;
}

const { category, heading, blurb } = Astro.props as Props;

const reviews = reviewsFor(category);
const agg = aggregate(category);
const counts = categoryCounts();
const total = aggregate(null).count;
const span = formatRange(agg.from, agg.to);

// Every seventh card runs wide as a pull-quote, and only when it is short
// enough to read as one. Keeps the grid from becoming a flat wall.
const isFeature = (r: (typeof reviews)[number], i: number) =>
  i % 7 === 3 && r.text.length < 320;

const tabs = [
  { slug: null as CategorySlug | null, label: "All", href: "/reviews/", count: total },
  ...CATEGORIES.map((c) => ({
    slug: c.slug,
    label: c.label,
    href: `/reviews/${c.slug}/`,
    count: counts[c.slug],
  })),
];
---

<div class="reviews-root bg-background">
  <section class="relative overflow-hidden border-b border-border/40">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-80 opacity-[0.16]"
      style="background: radial-gradient(60% 100% at 50% 100%, hsl(24 95% 53%), transparent 70%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-6 pb-14 pt-28 md:px-10 md:pb-20 md:pt-36">
      <p class="mb-6 text-[0.6875rem] uppercase tracking-[0.32em] text-primary/80">Reviews</p>

      <h1
        class="max-w-3xl text-balance font-semibold leading-[1.06] tracking-[-0.03em] text-foreground text-[2.5rem] sm:text-[3.25rem] md:text-[4rem]"
      >
        {heading}
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-foreground/55 md:text-lg">
        {blurb}
      </p>

      {
        agg.count > 0 && (
          <>
            <div class="mt-12 flex flex-wrap items-end gap-x-10 gap-y-7 md:gap-x-16">
              <div>
                <p class="text-[2.75rem] font-semibold leading-none tracking-[-0.03em] text-foreground tabular-nums md:text-[3.5rem]">
                  {agg.average.toFixed(1)}
                  <span class="text-2xl text-foreground/30 md:text-3xl">/5</span>
                </p>
                <p class="mt-2.5 text-[0.6875rem] uppercase tracking-[0.16em] text-foreground/40">
                  Average rating
                </p>
              </div>
              <div>
                <p class="text-[2.75rem] font-semibold leading-none tracking-[-0.03em] text-foreground tabular-nums md:text-[3.5rem]">
                  {agg.count.toLocaleString("en-US")}
                </p>
                <p class="mt-2.5 text-[0.6875rem] uppercase tracking-[0.16em] text-foreground/40">
                  Reviews published
                </p>
              </div>
              <div>
                <p class="text-[2.75rem] font-semibold leading-none tracking-[-0.03em] text-foreground tabular-nums md:text-[3.5rem]">
                  {agg.programCount}
                </p>
                <p class="mt-2.5 text-[0.6875rem] uppercase tracking-[0.16em] text-foreground/40">
                  Programmes
                </p>
              </div>
            </div>

            {/* Says exactly what the number covers, so the count on this page
                and the count in the schema are the same thing a reader can
                check by scrolling. */}
            <p class="mt-9 max-w-2xl text-sm leading-relaxed text-foreground/40">
              Each review below was written by a student on the feedback form at the
              end of their programme{span && <> between {span}</>}, and rated 4 out of 5
              or higher. The dates are the day each one was submitted. Nothing here is
              written by us.
            </p>
          </>
        )
      }
    </div>
  </section>

  <nav
    aria-label="Filter reviews by programme type"
    class="sticky top-0 z-30 border-b border-border/40 bg-background/85 backdrop-blur-xl"
  >
    <div class="mx-auto max-w-6xl overflow-x-auto px-6 md:px-10">
      <ul class="flex min-w-max gap-1 py-3">
        {
          tabs.map((t) => {
            const active = t.slug === category;
            return (
              <li>
                <a
                  href={t.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm transition-colors",
                    active
                      ? "bg-primary text-primary-foreground font-medium"
                      : "text-foreground/55 hover:bg-secondary hover:text-foreground/85",
                  ]}
                >
                  {t.label}
                  <span
                    class:list={[
                      "text-xs tabular-nums",
                      active ? "text-primary-foreground/60" : "text-foreground/30",
                    ]}
                  >
                    {t.count}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </nav>

  <section class="mx-auto max-w-6xl px-6 py-14 md:px-10 md:py-20">
    {
      reviews.length === 0 ? (
        <div class="mx-auto max-w-lg py-24 text-center">
          <p class="text-lg text-foreground/70">No reviews published here yet.</p>
          <p class="mt-3 text-sm leading-relaxed text-foreground/40">
            Reviews appear once they have been through the approval pass. Run
            <code class="mx-1 rounded bg-secondary px-1.5 py-0.5 text-xs">
              node scripts/pull-reviews.mjs
            </code>
            and approve a batch.
          </p>
          <a
            href="/reviews/"
            class="mt-8 inline-block text-sm text-primary underline underline-offset-4"
          >
            See all reviews
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <ReviewCard review={r} feature={isFeature(r, i)} />
          ))}
        </div>
      )
    }
  </section>
</div>

<style>
  .reviews-root {
    /* One accent per category, all from the design system swatches. */
    --review-forge: #ffbc3b; /* Forge Sunrise */
    --review-levelup: #f97015; /* Amber 500, parent primary */
    --review-online: #d76742; /* Bronze / Amber 700 */
  }
</style>
