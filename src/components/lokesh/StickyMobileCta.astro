---
/**
 * Sticky mobile bottom CTA — full-width gold pill anchored to the
 * bottom of every mobile viewport.
 *
 * CRO context (from `Lokesh_CRO_Strategy_HANDOFF.md`):
 *   - 97% of traffic to this page is mobile
 *   - Median scroll depth was 6%; users were bouncing in 16s
 *   - A persistent always-visible CTA captures the click anywhere on
 *     the page, not just at the hero or pricing card
 *
 * Hidden on desktop (md:hidden) — the desktop layout already has the
 * primary CTA in the hero plus 4 inline CTAs scattered down the page.
 *
 * On click, the global UTM-forwarding script in BaseLayout.astro
 * intercepts, appends UTMs from sessionStorage, fires Pixel Lead +
 * InitiateCheckout, then navigates.
 */
interface Props {
  href: string;
  price: number;
  label?: string;
  course?: string;
}

const { href, price, label, course = "" } = Astro.props;
// Action verb + price anchor reads as a clearer commitment than the
// vague "Sign Up Now ₹X,XXX" the page used to ship with. Middle dot
// separator (was an em-dash) — the user pushed back on em-dashes
// across the site as reading like AI-generated copy.
const ctaText = label || `Enrol · ₹${price.toLocaleString("en-IN")}`;
---

<div
  class="md:hidden fixed bottom-0 inset-x-0 z-[55] px-3 pt-2 pointer-events-none"
  style="padding-bottom: max(12px, env(safe-area-inset-bottom));"
>
  {/* Subtle blur backdrop so content scrolling behind doesn't fight
      with the CTA — but the CTA itself sits ABOVE the blur. */}
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#050505] via-[#050505]/95 to-transparent pointer-events-none"
  ></div>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    data-cta="sticky-mobile-bottom"
    data-mc-course={course}
    class="relative pointer-events-auto flex items-center justify-center gap-2 w-full py-3.5 px-5 rounded-full text-center font-semibold text-[15px] tracking-[0.01em] text-[#2a1300] active:scale-[0.99] transition-transform duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-200 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
    style="background: radial-gradient(120% 100% at 50% 0%, #ffe5b8 0%, #e3b671 30%, #c8924d 60%, #a87545 100%); box-shadow: 0 14px 28px -8px rgba(200, 146, 77, 0.6), inset 0 1px 0 rgba(255, 230, 190, 0.85), inset 0 -1px 0 rgba(80, 35, 0, 0.4); touch-action: manipulation; min-height: 50px;"
  >
    {ctaText}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 5l7 7-7 7" />
    </svg>
  </a>
</div>
