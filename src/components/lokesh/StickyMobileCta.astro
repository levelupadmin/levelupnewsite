---
/**
 * Sticky mobile bottom CTA — gold pill anchored to the bottom of the
 * viewport on mobile. Sits to the LEFT of the global floating WhatsApp
 * button (which lives at bottom-5 right-5, occupying ~68px on the
 * right). Hides while a CTA marked `[data-mc-hero-cta]` is on screen
 * so the user doesn't see two identical buttons at once. Falls back to
 * always-visible if no hero CTA is marked, so existing pages keep
 * working unchanged.
 */
interface Props {
  href: string;
  price: number;
  label?: string;
  course?: string;
}

const { href, price, label, course = "" } = Astro.props;
const ctaText = label || `Sign Up Now ₹${price.toLocaleString("en-IN")}`;
---

{/* Bottom-aligned with the global WhatsApp FAB at bottom-5 right-5
    (BaseLayout). Both pill bottom and FAB bottom sit at 20px from
    viewport edge so they read as a single bottom-aligned bar. The pill
    ends at right-[76px] which leaves a 20px gap between its right edge
    and the FAB's left edge (FAB is 48px wide at right-5). */}
<div
  id="mc-sticky-cta"
  class="md:hidden fixed bottom-5 left-3 right-[76px] z-[55] pointer-events-none transition-[opacity,transform] duration-200 ease-out"
>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    data-cta="sticky-mobile-bottom"
    data-mc-course={course}
    class="relative pointer-events-auto flex items-center justify-center gap-2 w-full py-3 px-5 rounded-full text-center font-semibold text-[15px] tracking-[0.01em] text-[#3a1a00] active:scale-[0.99] transition-transform duration-150"
    style="background: radial-gradient(120% 100% at 50% 0%, #ffe5b8 0%, #e3b671 30%, #c8924d 60%, #8c5e2e 100%); box-shadow: 0 14px 28px -8px rgba(200, 146, 77, 0.6), inset 0 1px 0 rgba(255, 230, 190, 0.85), inset 0 -1px 0 rgba(80, 35, 0, 0.4); touch-action: manipulation; height: 48px;"
  >
    {ctaText}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 5l7 7-7 7" />
    </svg>
  </a>
</div>

<script is:inline>
  (function () {
    function init() {
      var bar = document.getElementById("mc-sticky-cta");
      if (!bar) return;
      var heroCta = document.querySelector("[data-mc-hero-cta]");
      var visible = null;
      function set(v) {
        if (v === visible) return;
        visible = v;
        if (v) {
          bar.style.opacity = "1";
          bar.style.transform = "translateY(0)";
          bar.style.pointerEvents = "auto";
        } else {
          bar.style.opacity = "0";
          bar.style.transform = "translateY(12px)";
          bar.style.pointerEvents = "none";
        }
      }
      // No hero CTA marked? Just show the sticky always (legacy pages).
      if (!heroCta) {
        set(true);
        return;
      }
      function update() {
        var r = heroCta.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var heroVisible = r.top < vh && r.bottom > 0;
        set(!heroVisible);
      }
      update();
      // Lightweight throttle: at most once per ~16ms via setTimeout (rAF
      // would be nicer but isn't always reliable in headless test envs).
      var pending = false;
      function onScroll() {
        if (pending) return;
        pending = true;
        setTimeout(function () {
          update();
          pending = false;
        }, 16);
      }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
