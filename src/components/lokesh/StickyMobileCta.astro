---
/**
 * Sticky mobile top-right pill — pinned to the very top-right of the page
 * on mobile only. Mirrors the Framer design (small peach-translucent pill
 * with thin white border) rather than a wide, aggressive gradient bar.
 *
 * The Framer original keeps a small "Buy now at ₹1,499" pill at the
 * top-right on every breakpoint. On the cloned page we hide this pill on
 * desktop because the header already shows the same CTA next to the logo,
 * but show it on mobile where the desktop header pill is hidden — this
 * way users always have a CTA visible above the fold without overpowering
 * the hero.
 *
 * On click, the global UTM-forwarding script in BaseLayout.astro
 * intercepts, appends UTMs from sessionStorage, fires Pixel Lead +
 * InitiateCheckout, then navigates.
 */
interface Props {
  href: string;
  price: number;
  label?: string;
  course?: string;
}

const { href, price, label, course = "" } = Astro.props;
const ctaText = label || `Buy now at ₹${price.toLocaleString("en-IN")}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-cta="sticky-mobile-top"
  data-mc-course={course}
  class="md:hidden fixed top-3 right-3 z-[55] inline-flex items-center justify-center px-3 py-1.5 text-[12px] font-semibold tracking-[-0.01em] text-[#3a1a00] rounded-[19px] bg-[rgba(255,203,148,0.55)] backdrop-blur-md border border-white/25 shadow-[0_2px_4px_rgba(0,0,0,0.35),0_10px_18px_-2px_rgba(255,203,148,0.18),inset_0_1px_0_rgba(255,255,255,0.5)] active:scale-[0.98] transition-transform duration-150"
  style="touch-action: manipulation; min-height: 36px;"
>
  {ctaText}
</a>
