---
/**
 * Buy button. A plain <a> to the checkout so the site-wide tracking script
 * in BaseLayout sees every tap (it listens for clicks on links to
 * app.leveluplearning.in). Opens in the same tab. Links to a checkout carry
 * data-mc-buy; the ghost variant can also link to an anchor on the page.
 *
 *   <CtaButton href={offer.checkoutUrl} label="Get the masterclass" price={2499} placement="price-card" />
 *
 * Renders: Get the masterclass · ₹2,499
 */
import "@/styles/masterclass.css";
import { formatPrice } from "@/data/masterclass/shared";

interface Props {
  href: string;
  label: string;
  /** Appended as " · ₹2,499". Leave out to show the label only. */
  price?: number;
  /** Where the button sits, e.g. "hero", "price-card". Sent as data-mc-cta. */
  placement?: string;
  /** Course slug, sent as data-mc-course. */
  course?: string;
  variant?: "primary" | "ghost";
  size?: "md" | "lg";
  /** Full width. */
  block?: boolean;
  /** Marks the first-screen button (data-mc-hero-cta) for the sticky bar. */
  hero?: boolean;
  /** Show the arrow icon. Default true. */
  arrow?: boolean;
  id?: string;
  class?: string;
  style?: string;
  ariaLabel?: string;
}

const {
  href,
  label,
  price,
  placement,
  course,
  variant = "primary",
  size = "md",
  block = false,
  hero = false,
  arrow = true,
  id,
  class: className,
  style,
  ariaLabel,
} = Astro.props;

// The last word travels with the price and the arrow, so a narrow phone
// never leaves the arrow or "· ₹2,499" alone on a line.
const words = label.trim().split(/\s+/);
const last = words.pop() ?? "";
const head = words.join(" ");
// Only checkout links count as buy buttons (the sticky bar hides while one
// is on screen); a ghost "See the lessons" link to an anchor does not.
const isBuy = /\/checkout\//.test(href);
---

<a
  href={href}
  id={id}
  class:list={[
    "mck-cta",
    variant === "ghost" && "mck-cta--ghost",
    size === "lg" && "mck-cta--lg",
    block && "mck-cta--block",
    className,
  ]}
  style={style}
  aria-label={ariaLabel}
  data-mc-buy={isBuy ? "" : undefined}
  data-mc-cta={placement}
  data-mc-course={course}
  data-mc-hero-cta={hero ? "true" : undefined}
>
  <span class="mck-cta__text">
    {head && <>{head}{" "}</>}
    <span class="mck-cta__tail">
      {last}
      {typeof price === "number" && (
        <>
          <span class="mck-cta__sep" aria-hidden="true">·</span>
          <span class="mck-cta__price">{formatPrice(price)}</span>
        </>
      )}
      {arrow && (
        <svg class="mck-cta__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      )}
    </span>
  </span>
</a>
