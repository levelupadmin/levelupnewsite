---
/**
 * "Is this for you?": who the course suits and who it does not. Saying who
 * it is not for cuts refunds.
 *
 *   <IsThisForYou
 *     forYou={["You want to write or direct films.", "..."]}
 *     notForYou={["You want camera settings or editing software.", "..."]}
 *     cta={{ href, label: "Get the masterclass", price: 2499, placement: "fit" }}
 *   />
 */
import SectionShell from "./SectionShell.astro";
import CtaRow from "./CtaRow.astro";
import type { CtaProps } from "./types";

interface Props {
  forYou: string[];
  notForYou?: string[];
  eyebrow?: string | false;
  heading?: string;
  body?: string;
  forLabel?: string;
  notForLabel?: string;
  cta?: CtaProps;
  id?: string;
  tone?: "plain" | "raised";
  class?: string;
  style?: string;
}

const {
  forYou,
  notForYou = [],
  eyebrow = "Before you buy",
  heading = "Is this for you?",
  body,
  forLabel = "For you if",
  notForLabel = "Not for you if",
  cta,
  id = "is-this-for-you",
  tone,
  class: className,
  style,
} = Astro.props;
---

<SectionShell eyebrow={eyebrow} heading={heading} body={body} id={id} tone={tone} class={className} style={style}>
  <div class="mck-fit" style={notForYou.length ? undefined : "grid-template-columns:1fr;max-width:760px;margin-inline:auto"}>
    <div class="mck-card mck-card--gold mck-fit__card mck-reveal">
      <p class="mck-fit__label">
        <span class="mck-icon mck-icon--yes" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        </span>
        {forLabel}
      </p>
      <ul class="mck-list">
        {forYou.map((line) => (
          <li>
            <span class="mck-icon mck-icon--yes" aria-hidden="true" style="width:22px;height:22px;margin-top:1px">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </div>
    {notForYou.length > 0 && (
      <div class="mck-card mck-fit__card mck-fit__card--no mck-reveal" style="--mck-delay:120ms">
        <p class="mck-fit__label">
          <span class="mck-icon mck-icon--no" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </span>
          {notForLabel}
        </p>
        <ul class="mck-list">
          {notForYou.map((line) => (
            <li>
              <span class="mck-icon mck-icon--no" aria-hidden="true" style="width:22px;height:22px;margin-top:1px">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
              </span>
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
  {cta && <CtaRow {...cta} />}
</SectionShell>
