---
/**
 * FAQ on native <details>: zero JS, keyboard and screen-reader friendly, and
 * every answer is in the HTML for search. Pair with faqJsonLd() using the
 * same array. Spread SHARED_FAQ entries in for the refund, access and
 * device answers.
 *
 *   <SectionShell eyebrow="FAQ" heading="Questions buyers ask" width="narrow">
 *     <FaqList faqs={[...faqs, SHARED_FAQ.refund]} courseName="Nelson Dilipkumar Masterclass" />
 *   </SectionShell>
 */
import "@/styles/masterclass.css";
import RevealScript from "./RevealScript.astro";
import type { FaqItem } from "./types";

interface Props {
  faqs: FaqItem[];
  /** Open the first question. Default false. */
  openFirst?: boolean;
  /** Used in the WhatsApp message. Pass false as `whatsapp` to hide the help line. */
  courseName?: string;
  whatsapp?: boolean;
  class?: string;
}

const { faqs, openFirst = false, courseName, whatsapp = true, class: className } = Astro.props;
const waText = courseName
  ? `Hi, I have a question about the ${courseName}`
  : "Hi, I have a question about a LevelUp masterclass";
const waHref = `https://api.whatsapp.com/send?phone=919791520177&text=${encodeURIComponent(waText)}`;
---

<div class:list={["mck", className]}>
  <div class="mck-faq">
    {faqs.map((f, i) => (
      <details class="mck-faq__item mck-reveal" open={openFirst && i === 0} style={`--mck-delay:${Math.min(i, 4) * 50}ms`}>
        <summary>
          <span>{f.question}</span>
          <span class="mck-faq__icon" aria-hidden="true"></span>
        </summary>
        <div class="mck-faq__answer">
          <p>
            {f.answer}
            {f.link && (
              <>
                {" "}
                <a class="mck-link" href={f.link.href}>{f.link.label}</a>
              </>
            )}
          </p>
        </div>
      </details>
    ))}
  </div>
  {whatsapp && (
    <div class="mck-faq__help mck-reveal">
      <p class="mck-small" style="margin:0">Still have a question?</p>
      <a class="mck-wa" href={waHref} target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.83 11.83 0 0 0 12 0C5.4 0 0 5.4 0 12c0 2.1.55 4.13 1.6 5.93L0 24l6.27-1.65A11.94 11.94 0 0 0 12 24c6.6 0 12-5.4 12-12 0-3.18-1.24-6.18-3.48-8.52ZM12 22a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.72.98 1-3.62-.24-.37A9.94 9.94 0 0 1 2 12c0-5.5 4.5-10 10-10s10 4.5 10 10-4.5 10-10 10Z" /></svg>
        Ask us on WhatsApp
      </a>
    </div>
  )}
</div>
<RevealScript />
