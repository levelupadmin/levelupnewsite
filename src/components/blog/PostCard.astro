---
import {
  CATEGORY_BY_SLUG,
  TYPE_LABEL,
  formatDate,
  isoDate,
  postPath,
  type Post,
} from "@/lib/blog";

interface Props {
  post: Post;
}

const { post } = Astro.props as Props;
const { title, category, type, answer, publishDate } = post.data;
const cat = CATEGORY_BY_SLUG[category];

/* The card shows the start of the answer, not a separate excerpt field. One
   answer, written once, used everywhere. */
const trimmed = answer.length > 190 ? `${answer.slice(0, 190).trimEnd()}…` : answer;
---

<article class="group relative flex flex-col rounded-2xl border border-border bg-card/40 p-6 transition-colors hover:border-foreground/20 md:p-7">
  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.6875rem] uppercase tracking-[0.16em]">
    <span class="text-primary/80">{cat.label}</span>
    <span aria-hidden="true" class="text-foreground/20">/</span>
    <span class="text-foreground/40">{TYPE_LABEL[type]}</span>
  </div>

  <h2 class="text-xl font-semibold leading-snug tracking-[-0.02em] text-foreground md:text-[1.375rem]">
    <a href={postPath(post)} class="after:absolute after:inset-0 after:content-['']">
      {title}
    </a>
  </h2>

  <p class="mt-3 text-sm leading-relaxed text-foreground/55">{trimmed}</p>

  <time datetime={isoDate(publishDate)} class="mt-5 text-[0.6875rem] uppercase tracking-[0.16em] text-foreground/30">
    {formatDate(publishDate)}
  </time>
</article>
