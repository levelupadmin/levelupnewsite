---
import { CATEGORY_BY_SLUG, postPath, type Post, type Related } from "@/lib/blog";

interface Props {
  post: Post;
  related: Related;
  /** Cap on stories shown. Decision pages pass Infinity. */
  storyLimit?: number;
}

const { post, related, storyLimit = Infinity } = Astro.props as Props;
const cat = CATEGORY_BY_SLUG[post.data.category];

const stories = related.stories.slice(0, storyLimit);
const craft = related.craft;
const { decision, programme } = related;

const hasAnything =
  decision !== null || programme !== null || craft.length > 0 || stories.length > 0;

/*
  Every link below is computed from frontmatter in src/lib/blog.ts. Nothing on
  this page is a hand-maintained related-posts list: give a post the right
  category and it turns up here on its own.
*/
---

{
  hasAnything && (
    <nav aria-label="Related reading" class="mt-16 border-t border-border pt-10">
      {decision && (
        <div class="mb-10">
          <h2 class="text-[0.6875rem] uppercase tracking-[0.2em] text-foreground/40">
            Choosing a course
          </h2>
          <a
            href={postPath(decision)}
            class="group mt-4 block rounded-2xl border border-border bg-card/40 p-6 transition-colors hover:border-foreground/20"
          >
            <p class="text-lg font-semibold leading-snug tracking-[-0.02em] text-foreground">
              {decision.data.title}
            </p>
            <p class="mt-2 text-sm leading-relaxed text-foreground/55">
              {decision.data.description}
            </p>
          </a>
        </div>
      )}

      {programme && (
        <div class="mb-10">
          <h2 class="text-[0.6875rem] uppercase tracking-[0.2em] text-foreground/40">
            The programme
          </h2>
          <a
            href={programme.url}
            class="mt-4 inline-flex items-center gap-2 text-base text-foreground/80 underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
          >
            {programme.name}
          </a>
        </div>
      )}

      {craft.length > 0 && (
        <div class="mb-10">
          <h2 class="text-[0.6875rem] uppercase tracking-[0.2em] text-foreground/40">
            More on {cat.label.toLowerCase()}
          </h2>
          <ul class="mt-4 space-y-3">
            {craft.map((p) => (
              <li>
                <a
                  href={postPath(p)}
                  class="text-base leading-snug text-foreground/75 underline decoration-foreground/20 underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground/50"
                >
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {stories.length > 0 && (
        <div>
          <h2 class="text-[0.6875rem] uppercase tracking-[0.2em] text-foreground/40">
            People who did it
          </h2>
          <ul class="mt-4 space-y-3">
            {stories.map((p) => (
              <li>
                <a
                  href={postPath(p)}
                  class="text-base leading-snug text-foreground/75 underline decoration-foreground/20 underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground/50"
                >
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </nav>
  )
}
