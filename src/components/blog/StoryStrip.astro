---
import type { Post } from "@/lib/blog";

interface Props {
  student: NonNullable<Post["data"]["student"]>;
}

const { student } = Astro.props as Props;
---

<section aria-label="Before and after" class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2">
  <div class="bg-card/60 p-6 md:p-7">
    <p class="text-[0.6875rem] uppercase tracking-[0.2em] text-foreground/40">Before</p>
    <p class="mt-3 text-lg leading-snug text-foreground/80">{student.before}</p>
  </div>
  <div class="bg-card/60 p-6 md:p-7">
    <p class="text-[0.6875rem] uppercase tracking-[0.2em] text-primary/80">After</p>
    <p class="mt-3 text-lg leading-snug text-foreground">{student.after}</p>
  </div>
</section>

<p class="mt-4 text-sm text-foreground/45">
  {student.name}
  {student.city && <span> · {student.city}</span>}
  <span> · {student.programme}</span>
</p>
