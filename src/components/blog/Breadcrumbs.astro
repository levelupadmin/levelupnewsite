---
import type { Crumb } from "@/lib/blog";

interface Props {
  items: Crumb[];
}

const { items } = Astro.props as Props;
---

<nav aria-label="Breadcrumb" class="text-[0.6875rem] uppercase tracking-[0.18em] text-foreground/40">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((crumb, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-foreground/20">/</span>}
          {i === items.length - 1 ? (
            <span class="line-clamp-1 text-foreground/60" aria-current="page">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.path} class="transition-colors hover:text-foreground/70">
              {crumb.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
