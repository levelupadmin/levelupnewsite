---
import { render } from "astro:content";
import PostHeader from "./PostHeader.astro";
import RelatedLinks from "./RelatedLinks.astro";
import SourceList from "./SourceList.astro";
import type { Post, Related } from "@/lib/blog";

interface Props {
  post: Post;
  related: Related;
}

const { post, related } = Astro.props as Props;
const { Content } = await render(post);
---

{/*
  Decision page. The order the handoff fixes: H1, answer, comparison table,
  per-option detail, who should pick what, FAQ. The middle four come from the
  markdown body, so an author controls them by writing the post rather than by
  filling in template slots.
*/}
<PostHeader post={post} />

<div class="mx-auto max-w-3xl px-6 pb-24 pt-12 md:px-8 md:pb-32">
  <div class="post-body">
    <Content />
  </div>

  <SourceList sources={post.data.sources} />
  <RelatedLinks post={post} related={related} />
</div>
