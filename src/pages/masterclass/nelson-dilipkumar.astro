  type Conn = { saveData?: boolean; effectiveType?: string };
  const conn = (navigator as Navigator & { connection?: Conn }).connection;
  const lowData = Boolean(conn?.saveData) || /(^|-)2g$/.test(conn?.effectiveType ?? "");

  /* ------------------------------------------------------------ */
  /* Hero clip: a 2 s pull-back from Nelson's face to the set.     */
  /* Starts after window load, plays once and holds the last       */
  /* frame. Its first frame is the poster, so the swap is seamless.*/
  /* ------------------------------------------------------------ */
  const hero = document.querySelector<HTMLElement>("[data-nl-hero]");
  const heroVideo = hero?.querySelector<HTMLVideoElement>("video") ?? null;
  const heroImg = hero?.querySelector<HTMLImageElement>(".nl-hero__poster") ?? null;

  function startHero() {
    if (!hero || !heroVideo || reduceMotion || lowData) return;
    if (hero.getBoundingClientRect().bottom <= 0) return;
    const src = desktop.matches ? heroVideo.dataset.srcD : heroVideo.dataset.srcM;
    if (!src) return;
    if (heroImg?.currentSrc) heroVideo.poster = heroImg.currentSrc;
    heroVideo.addEventListener("playing", () => hero.classList.add("is-playing"), { once: true });
    heroVideo.src = src;
    heroVideo.muted = true;
    heroVideo.play().catch(() => {
      /* Autoplay refused (Low Power Mode, data saver): the poster stays. */
    });
  }
  if (document.readyState === "complete") window.setTimeout(startHero, 150);
  else window.addEventListener("load", () => window.setTimeout(startHero, 150), { once: true });

  if (hero && "IntersectionObserver" in window) {
    new IntersectionObserver((entries) => {
      for (const e of entries) hero.classList.toggle("is-off", !e.isIntersecting);
    }).observe(hero);
  }

  /* ------------------------------------------------------------ */
  /* Sticky bar and WhatsApp button                                */
  /* ------------------------------------------------------------ */
  const sticky = document.querySelector<HTMLElement>("[data-nl-sticky]");
  const heroCta = document.querySelector<HTMLElement>("[data-mc-hero-cta]");
  const buys = Array.from(document.querySelectorAll<HTMLElement>("main [data-mc-buy]"));
  const footer = document.querySelector<HTMLElement>("footer");
  const root = document.documentElement;
  const onScreen = new Set<Element>();

  function updateBars() {
    const heroShowing = heroCta ? onScreen.has(heroCta) : false;
    const heroPassed = heroCta ? heroCta.getBoundingClientRect().bottom < 0 : true;
    const anyBuy = buys.some((b) => onScreen.has(b));
    const footerShowing = footer ? onScreen.has(footer) : false;
    sticky?.classList.toggle("is-on", heroPassed && !anyBuy && !footerShowing);
    root.classList.toggle("nl-fab-hold", heroShowing);
  }

  if ("IntersectionObserver" in window) {
    const barIo = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) onScreen.add(e.target);
        else onScreen.delete(e.target);
      }
      updateBars();
    });
    buys.forEach((b) => barIo.observe(b));
    if (footer) barIo.observe(footer);
  } else {
    root.classList.remove("nl-fab-hold");
  }

  /* ------------------------------------------------------------ */
  /* "Idea" clips: load and play only while on screen.             */
  /* ------------------------------------------------------------ */
  const clips = Array.from(document.querySelectorAll<HTMLElement>("[data-nl-clip]"));

  function playClip(box: HTMLElement) {
    const v = box.querySelector("video");
    if (!v) return;
    if (!v.getAttribute("src") && v.dataset.src) v.src = v.dataset.src;
    v.muted = true;
    v.play()
      .then(() => box.classList.remove("is-blocked"))
      .catch(() => box.classList.add("is-blocked"));
  }

  for (const box of clips) {
    const v = box.querySelector("video");
    v?.addEventListener("playing", () => box.classList.add("is-playing"));
    v?.addEventListener("pause", () => box.classList.remove("is-playing"));
    box.querySelector("button")?.addEventListener("click", () => playClip(box));
    if (reduceMotion || lowData || !("IntersectionObserver" in window)) box.classList.add("is-blocked");
  }

  if (!reduceMotion && !lowData && "IntersectionObserver" in window) {
    const clipIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const box = e.target as HTMLElement;
          if (e.isIntersecting && e.intersectionRatio >= 0.5) playClip(box);
          else box.querySelector("video")?.pause();
        }
      },
      { threshold: [0, 0.5] }
    );
    clips.forEach((c) => clipIo.observe(c));
  }

  /* ------------------------------------------------------------ */
  /* Trailer: the YouTube player loads only after a tap.           */
  /* ------------------------------------------------------------ */
  document.querySelectorAll<HTMLAnchorElement>("[data-nl-yt]").forEach((a) => {
    a.addEventListener("click", (ev) => {
      ev.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${a.dataset.nlYt}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      frame.title = a.dataset.title ?? "Trailer";
      frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      frame.allowFullscreen = true;
      frame.className = "nl-trailer__frame";
      a.replaceWith(frame);
      frame.focus();
    });
  });
</script>
