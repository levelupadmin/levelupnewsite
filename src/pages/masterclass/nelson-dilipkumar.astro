---
/**
 * /masterclass/nelson-dilipkumar, rebuilt for Meta ad traffic (17 Oct 2026).
 *
 * Order follows the audit's flow for a cold Instagram visitor: hook and
 * proof, what you get and the price, a sample, the lessons, the skills, his
 * own words, reviews, fit, value against price, the 7-day refund, FAQ, and
 * a final button.
 *
 * Zero-JS Astro throughout. The only scripts are the kit's reveal script and
 * one small module below (hero clip, "idea" clips, trailer, sticky bar). The
 * site navbar is the one React island, hydrated when the browser is idle.
 *
 * Copy and page data: src/data/masterclass/content/nelson-dilipkumar.ts.
 * Shared facts (price, checkout, 29 lessons, 2 h 20 min, refund rule):
 * src/data/masterclass/shared.ts.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SiteNavbar, SiteFooter } from "@/components/SiteChrome";
import {
  SectionShell,
  CtaButton,
  RefundLine,
  RevealScript,
  KitPicture,
  CourseFacts,
  IsThisForYou,
  SkillsYouGain,
  InHisWords,
  TryItFor7Days,
  ValueAgainstPrice,
  WhatYouGetToday,
  ReviewWall,
  FaqList,
  CrossSell,
} from "@/components/masterclass";
import { OFFERINGS, SHARED_FAQ, courseSchemaFields, formatRuntime, formatPrice } from "@/data/masterclass/shared";
import { courseJsonLd, breadcrumbJsonLd, faqJsonLd } from "@/lib/structuredData";
import {
  SLUG,
  HERO,
  HERO_COPY,
  CTA_LABELS,
  TRAILER,
  ON_SET,
  CERTIFICATE,
  FILMS,
  IDEAS,
  LESSONS,
  LESSONS_SHOWN,
  INCLUDED,
  BONUS_HEADING,
  BONUSES,
  PAY_NOTE,
  SKILLS,
  FOR_YOU,
  NOT_FOR_YOU,
  VALUE_ROWS,
  QUOTES,
  REVIEWS,
  REVIEW_NOTE,
  FAQ_LANGUAGE,
  FAQ_LENGTH,
  FAQ_WHO,
  FAQ_EXPERIENCE,
  FAQ_WHY_PAY,
  FAQ_TECHNICAL,
  FAQ_CERTIFICATE,
  FAQ_BONUSES,
  FAQ_LIVE,
  FAQ_INDUSTRY,
  FAQ_PRICE,
  META,
} from "@/data/masterclass/content/nelson-dilipkumar";

const o = OFFERINGS[SLUG];
const runtime = formatRuntime(o.runtimeMinutes);
/** Same runtime with no-break spaces, so "2 h 20 min" never splits across lines. */
const runtimeNb = runtime.replace(/ /g, "\u00a0");
const cta = { href: o.checkoutUrl, price: o.price, course: o.slug };

const faqs = [
  FAQ_LANGUAGE,
  FAQ_LENGTH,
  FAQ_WHO,
  FAQ_EXPERIENCE,
  SHARED_FAQ.refund,
  SHARED_FAQ.access,
  SHARED_FAQ.devices,
  FAQ_CERTIFICATE,
  FAQ_BONUSES,
  FAQ_WHY_PAY,
  FAQ_TECHNICAL,
  FAQ_LIVE,
  FAQ_INDUSTRY,
  FAQ_PRICE,
];

const course = courseJsonLd({
  name: o.courseName,
  description: META.schemaDescription,
  path: `/masterclass/${SLUG}`,
  image: HERO.schemaImage,
  courseMode: "online",
  ...courseSchemaFields(SLUG),
  // Spoken language. The English subtitles are stated in the description.
  inLanguage: "ta",
});
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Masterclasses", path: "/masterclass/" },
  { name: "Nelson Dilipkumar", path: `/masterclass/${SLUG}/` },
]);
const faqSchema = faqJsonLd(faqs);

const shownLessons = LESSONS.slice(0, LESSONS_SHOWN);
const moreLessons = LESSONS.slice(LESSONS_SHOWN);
const pad = (n: number) => String(n).padStart(2, "0");
const ytThumb = `https://i.ytimg.com/vi_webp/${TRAILER.ytId}/maxresdefault.webp`;
const ytWatch = `https://www.youtube.com/watch?v=${TRAILER.ytId}`;
---

<BaseLayout
  title={META.title}
  description={META.description}
  path={`/masterclass/${SLUG}`}
  type="website"
  ogImage="/og/mc-nelson-dilipkumar.jpg"
  jsonLd={[course, breadcrumb, faqSchema]}
>
  {/* First-screen image, one per breakpoint. Preload is body-ok; the layout has no head slot. */}
  <link rel="preload" as="image" href={`${HERO.mobile.stem}.avif`} type="image/avif" media="(max-width: 899px)" fetchpriority="high" />
  <link rel="preload" as="image" href={`${HERO.desktop.stem}.avif`} type="image/avif" media="(min-width: 900px)" fetchpriority="high" />
  {/* Cinzel for the small caps lines only. Loaded without blocking render; the body uses Sora, which the layout already preloads. */}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&display=swap" /></noscript>
  {/* Hide the WhatsApp button while the hero button is on screen (phones), so it never sits on the hero copy. */}
  <script is:inline>document.documentElement.classList.add("nl-fab-hold");</script>

  <div class="nl-progress" aria-hidden="true"></div>
  <SiteNavbar client:idle />

  <main id="main-content" class="nl mck">
    {/* ============================== Hero ============================== */}
    <section class="nl-hero" data-nl-hero aria-labelledby="nl-hero-title">
      <div class="nl-hero__media">
        <div class="nl-hero__frame">
          <picture>
            <source media="(min-width: 900px)" type="image/avif" srcset={`${HERO.desktop.stem}.avif`} />
            <source media="(min-width: 900px)" type="image/webp" srcset={`${HERO.desktop.stem}.webp`} />
            <source media="(min-width: 900px)" srcset={`${HERO.desktop.stem}.jpg`} />
            <source type="image/avif" srcset={`${HERO.mobile.stem}.avif`} />
            <source type="image/webp" srcset={`${HERO.mobile.stem}.webp`} />
            <img
              class="nl-hero__poster"
              src={`${HERO.mobile.stem}.jpg`}
              width={HERO.mobile.width}
              height={HERO.mobile.height}
              alt={HERO.alt}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
          <video
            class="nl-hero__video"
            muted
            playsinline
            preload="none"
            disableremoteplayback
            aria-hidden="true"
            tabindex="-1"
            data-src-m={HERO.mobile.video}
            data-src-d={HERO.desktop.video}
          ></video>
        </div>
        <div class="nl-hero__shade" aria-hidden="true"></div>
        <div class="nl-grain" aria-hidden="true"></div>
      </div>

      <div class="nl-hero__body">
        <p class="nl-kicker nl-rise" style="--nl-d:0ms">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M7 5v14M17 5v14M2 9.5h5M2 14.5h5M17 9.5h5M17 14.5h5" /></svg>
          {HERO_COPY.kicker}
        </p>
        <p class="nl-eyebrow nl-rise" style="--nl-d:60ms">{HERO_COPY.eyebrow}</p>
        <h1 id="nl-hero-title" class="nl-h1 nl-rise" style="--nl-d:120ms">
          <span class="nl-h1__films">{HERO_COPY.h1.replace("Kolamaavu Kokila", "Kolamaavu\u00a0Kokila")}</span>
          <span class="nl-h1__how">{HERO_COPY.h1Line2}</span>
        </h1>
        <ul class="nl-hero__subs nl-rise" style="--nl-d:200ms">
          {HERO_COPY.subs.map((s) => <li>{s}</li>)}
        </ul>
        <div class="nl-hero__cta nl-rise" style="--nl-d:260ms">
          <CtaButton {...cta} label={CTA_LABELS.hero} placement="hero" hero size="lg" />
          <RefundLine />
        </div>
        <div class="nl-proof nl-rise" style="--nl-d:320ms">
          <p class="nl-proof__buyers">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            {HERO_COPY.proof}
          </p>
          {/* Founder's decision 9: this line stays exactly as it was. */}
          <p class="nl-proof__rating">
            <span class="nl-stars" aria-hidden="true">★★★★★</span>
            <strong>4.86/5</strong> · Trusted by <strong>18,000+ creators</strong> on LevelUp
          </p>
        </div>
      </div>
    </section>

    {/* ============================== Facts ============================== */}
    <div class="nl-facts">
      <div class="mck-wrap">
        <CourseFacts slug={SLUG} />
      </div>
    </div>

    {/* ============================== Films ============================== */}
    <section class="mck mck-section nl-films" id="films" aria-labelledby="nl-films-title">
      <div class="mck-wrap mck-wrap--wide">
        <header class="mck-head mck-reveal">
          <p class="mck-eyebrow">His films, 2018 to 2026</p>
          <h2 id="nl-films-title" class="mck-h2">The films behind <em>the lessons</em></h2>
          <div class="mck-body"><p>Kolamaavu Kokila, Doctor, Beast and Jailer each get their own lessons.</p></div>
        </header>
        <div class="nl-swipe mck-reveal" data-reveal="right">
        <ul class="nl-rail" aria-label="Films directed by Nelson Dilipkumar">
          {FILMS.map((f, i) => (
            <li class="nl-film mck-reveal" style={`--mck-delay:${i * 70}ms`}>
              <div class="nl-film__poster">
                <picture>
                  <source type="image/avif" srcset={`${f.stem}.avif`} />
                  <source type="image/webp" srcset={`${f.stem}.webp`} />
                  <img src={`${f.stem}.jpg`} alt={`${f.title} (${f.year}) poster`} width="400" height="600" loading="lazy" decoding="async" />
                </picture>
                {f.isNew && <span class="nl-film__new">New</span>}
              </div>
              <p class="nl-film__title">{f.title} <span class="nl-film__year">({f.year})</span></p>
              <p class="nl-film__note">{f.note}</p>
            </li>
          ))}
        </ul>
        </div>
        <div class="nl-cta-center mck-reveal">
          <CtaButton {...cta} label={CTA_LABELS.films} placement="films" />
        </div>
      </div>
    </section>

    {/* ============================== Price card ============================== */}
    <WhatYouGetToday
      price={o.price}
      items={INCLUDED}
      bonuses={BONUSES}
      bonusHeading={BONUS_HEADING}
      payNote={PAY_NOTE}
      eyebrow="What you get"
      heading={`${o.lessons} lessons. ${runtimeNb}. *${formatPrice(o.price)}.*`}
      cta={{ ...cta, label: CTA_LABELS.priceCard, placement: "price-card" }}
    />

    {/* ============================== Sample: trailer and three ideas ============================== */}
    <section class="mck mck-section nl-watch" id="trailer" aria-labelledby="nl-watch-title">
      <div class="mck-wrap">
        <header class="mck-head mck-reveal">
          <p class="mck-eyebrow">Watch first</p>
          <h2 id="nl-watch-title" class="mck-h2">See Nelson <em>before you buy</em></h2>
        </header>
        <figure class="nl-trailer mck-reveal" data-reveal="scale">
          <a
            class="nl-trailer__facade"
            href={ytWatch}
            target="_blank"
            rel="noopener"
            data-nl-yt={TRAILER.ytId}
            data-title={TRAILER.title}
            aria-label={`Play: ${TRAILER.title}`}
          >
            <img src={ytThumb} alt={TRAILER.alt} width="1280" height="720" loading="lazy" decoding="async" />
            <span class="nl-play" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
            </span>
          </a>
          <figcaption class="nl-trailer__cap">{TRAILER.caption}</figcaption>
        </figure>

        <h3 class="nl-ideas__title mck-reveal">Three ideas from the lessons</h3>
        <div class="nl-swipe mck-reveal" data-reveal="right">
        <ol class="nl-ideas">
          {IDEAS.map((idea, i) => (
            <li class="nl-idea mck-card mck-reveal" style={`--mck-delay:${i * 90}ms`}>
              <div class="nl-idea__clip" data-nl-clip>
                <picture>
                  <source type="image/avif" srcset={`${idea.stem}.avif`} />
                  <source type="image/webp" srcset={`${idea.stem}.webp`} />
                  <img src={`${idea.stem}.jpg`} alt="" width="960" height="426" loading="lazy" decoding="async" />
                </picture>
                <video muted loop playsinline preload="none" disableremoteplayback aria-hidden="true" tabindex="-1" data-src={idea.video}></video>
                <button type="button" class="nl-idea__play" aria-label={`Play the clip for: ${idea.label}`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
                </button>
              </div>
              <div class="nl-idea__body">
                <p class="nl-idea__label">{pad(i + 1)} · {idea.label}</p>
                <p class="nl-idea__text">{idea.text}</p>
                <span class="mck-chip">{idea.lesson}</span>
              </div>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>

    {/* ============================== Lessons ============================== */}
    <SectionShell
      id="lessons"
      eyebrow="The lessons"
      heading="All *29 lessons*"
      body={`${runtime} in all, in Tamil with English subtitles.`}
      width="narrow"
      tone="raised"
    >
      <ol class="nl-lessons">
        {shownLessons.map((l, i) => (
          <li class="nl-lesson mck-reveal" style={`--mck-delay:${Math.min(i, 5) * 50}ms`}>
            <span class="nl-lesson__n" aria-hidden="true">{pad(l.n)}</span>
            <div>
              <p class="nl-lesson__title"><span class="nl-sr">Lesson {l.n}: </span>{l.title}</p>
              <p class="nl-lesson__line">{l.line}</p>
            </div>
          </li>
        ))}
      </ol>
      <details class="nl-more">
        <summary>
          <span class="nl-more__btn">
            <span class="nl-more__show">Show all {LESSONS.length} lessons</span>
            <span class="nl-more__hide">Show fewer lessons</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        </summary>
        <ol class="nl-lessons nl-lessons--more" start={LESSONS_SHOWN + 1}>
          {moreLessons.map((l) => (
            <li class="nl-lesson">
              <span class="nl-lesson__n" aria-hidden="true">{pad(l.n)}</span>
              <div>
                <p class="nl-lesson__title"><span class="nl-sr">Lesson {l.n}: </span>{l.title}</p>
                <p class="nl-lesson__line">{l.line}</p>
              </div>
            </li>
          ))}
        </ol>
      </details>
    </SectionShell>

    {/* ============================== Skills ============================== */}
    <SkillsYouGain items={SKILLS} eyebrow="What you learn" heading="What you'll *know how to do*" />

    {/* ============================== In his words ============================== */}
    <InHisWords
      class="nl-words"
      speaker="Nelson Dilipkumar"
      eyebrow="From the lessons"
      heading="In his words"
      body="From the masterclass, English subtitles."
      quotes={QUOTES}
    />

    {/* ============================== Reviews ============================== */}
    <ReviewWall
      reviews={REVIEWS}
      initial={6}
      heading="What buyers *wrote*"
      body="Quoted as written in our feedback form. Each card names the course it reviews."
      note={REVIEW_NOTE}
    />

    {/* ============================== Fit ============================== */}
    <IsThisForYou forYou={FOR_YOU} notForYou={NOT_FOR_YOU} />

    {/* ============================== Value against price ============================== */}
    <ValueAgainstPrice
      price={o.price}
      lessons={o.lessons}
      runtimeMinutes={o.runtimeMinutes}
      comparisons={VALUE_ROWS}
      body="You pay once and keep it for life."
    />

    {/* ============================== Certificate ============================== */}
    <section class="mck mck-section mck-section--tight nl-cert" aria-labelledby="nl-cert-title">
      <div class="mck-wrap nl-cert__grid">
        <div class="nl-cert__img mck-reveal" data-reveal="scale">
          <KitPicture src={CERTIFICATE.src} alt={CERTIFICATE.alt} width={CERTIFICATE.width} height={CERTIFICATE.height} sizes="(min-width: 900px) 560px, 92vw" siblings={false} />
        </div>
        <div class="nl-cert__text mck-reveal" style="--mck-delay:100ms">
          <p class="mck-eyebrow">Certificate</p>
          <h2 id="nl-cert-title" class="mck-h2">Signed by <em>Nelson Dilipkumar</em></h2>
          <div class="mck-body"><p>Finish the lessons and get a Certificate of Completion. Download it as a PDF, print it or share it.</p></div>
        </div>
      </div>
    </section>

    {/* ============================== Try it for 7 days ============================== */}
    <TryItFor7Days cta={{ ...cta, label: CTA_LABELS.try, placement: "try-7-days" }} />

    {/* ============================== FAQ ============================== */}
    <SectionShell id="faq" eyebrow="FAQ" heading="Questions buyers ask" width="narrow">
      <FaqList faqs={faqs} courseName="Nelson Dilipkumar Masterclass" />
    </SectionShell>

    {/* ============================== Final button ============================== */}
    <section class="nl-final mck" aria-labelledby="nl-final-title">
      <div class="nl-final__bg" aria-hidden="true">
        <picture>
          <source type="image/avif" srcset={ON_SET.src.replace(/\.jpg$/, ".avif")} />
          <source type="image/webp" srcset={ON_SET.src.replace(/\.jpg$/, ".webp")} />
          <img src={ON_SET.src} alt="" width={ON_SET.width} height={ON_SET.height} loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="nl-final__body mck-wrap">
        <p class="mck-eyebrow mck-reveal">{o.lessons} lessons · {runtime}</p>
        <h2 id="nl-final-title" class="nl-final__h mck-reveal">You've seen the films. <em>Now hear how he made them.</em></h2>
        <ul class="nl-final__facts mck-reveal">
          <li>{o.lessons} lessons in Tamil, with English subtitles.</li>
          <li>{formatPrice(o.price)}, once.</li>
        </ul>
        <div class="nl-final__cta mck-reveal">
          <CtaButton {...cta} label={CTA_LABELS.closing} placement="closing" size="lg" />
          <RefundLine full />
          <p class="nl-proof__buyers">{HERO_COPY.proof}</p>
        </div>
        <p class="nl-final__credit">Nelson on the Kolamaavu Kokila set.</p>
      </div>
    </section>

    {/* ============================== More masterclasses ============================== */}
    <CrossSell current={SLUG} order={["lokesh-kanagaraj", "karthik-subbaraj"]} />

    {/* Sticky buy bar for phones: hidden while any buy button or the footer is on screen. */}
    <div class="nl-sticky" data-nl-sticky>
      <a class="nl-sticky__btn" href={o.checkoutUrl} data-mc-cta="sticky" data-mc-course={o.slug}>
        <span>{CTA_LABELS.sticky}</span>
        <span class="nl-sticky__sep" aria-hidden="true">·</span>
        <span>{formatPrice(o.price)}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
      </a>
    </div>
  </main>

  <SiteFooter />
  <RevealScript />
</BaseLayout>

<style is:global>
  /* ---------------------------------------------------------------- */
  /* Page tokens                                                       */
  /* ---------------------------------------------------------------- */
  .nl {
    --mck-font-body: "Sora", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --mck-font-display: "Cinzel", "Sora", system-ui, sans-serif;
    --nl-gutter: 20px;
    position: relative;
    background: var(--mck-bg);
    color: var(--mck-text);
    font-family: var(--mck-font-body);
    overflow-x: clip;
  }
  .nl-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Scroll progress line, CSS only where scroll timelines exist. */
  .nl-progress { display: none; }
  @supports (animation-timeline: scroll()) {
    .nl-progress {
      display: block;
      position: fixed;
      inset: 0 0 auto 0;
      height: 2px;
      z-index: 70;
      pointer-events: none;
      transform-origin: 0 50%;
      transform: scaleX(0);
      background: var(--mck-gold-gradient);
      animation: nl-progress linear both;
      animation-timeline: scroll(root block);
    }
    @keyframes nl-progress { to { transform: scaleX(1); } }
  }

  /* ---------------------------------------------------------------- */
  /* Hero                                                              */
  /* ---------------------------------------------------------------- */
  .nl-hero { position: relative; isolation: isolate; }
  .nl-hero__media {
    position: relative;
    height: min(122vw, 56vh);
    min-height: 330px;
    overflow: hidden;
    background: #0d0b08;
  }
  @supports (height: 1svh) {
    .nl-hero__media { height: min(122vw, 56svh); }
  }
  .nl-hero__frame {
    position: absolute;
    inset: 0;
    transform-origin: 50% 30%;
    animation: nl-push 26s ease-in-out 0.4s infinite alternate both;
  }
  .nl-hero.is-off .nl-hero__frame { animation-play-state: paused; }
  @keyframes nl-push {
    from { transform: scale(1); }
    to { transform: scale(1.07); }
  }
  .nl-hero__poster,
  .nl-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 6%;
  }
  .nl-hero__video { opacity: 0; transition: opacity 0.5s ease; }
  .nl-hero.is-playing .nl-hero__video { opacity: 1; }
  .nl-hero__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.65) 0%, rgba(5, 5, 5, 0) 20%),
      linear-gradient(180deg, rgba(5, 5, 5, 0) 46%, rgba(5, 5, 5, 0.72) 74%, #050505 98%),
      radial-gradient(120% 70% at 50% 30%, transparent 55%, rgba(0, 0, 0, 0.45) 100%);
  }
  .nl-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.05;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
