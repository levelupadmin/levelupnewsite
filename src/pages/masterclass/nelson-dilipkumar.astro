---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EpisodeAccordion from "@/components/lokesh/EpisodeAccordion";
import FAQAccordion from "@/components/lokesh/FAQAccordion";
import TestimonialCarousel from "@/components/lokesh/TestimonialCarousel";
import LokeshTrailer from "@/components/lokesh/LokeshTrailer";
import PosterMarquee from "@/components/lokesh/PosterMarquee";
import IntersectionPlayVideo from "@/components/lokesh/IntersectionPlayVideo";
import HeroPlayer from "@/components/lokesh/HeroPlayer";
import FilmsScrollStack from "@/components/lokesh/FilmsScrollStack";
import ScrollGlowLine from "@/components/lokesh/ScrollGlowLine";
import CountdownTimer from "@/components/lokesh/CountdownTimer";
import StickyMobileCta from "@/components/lokesh/StickyMobileCta.astro";
import PageInteractions from "@/components/lokesh/PageInteractions";
import { courseJsonLd, breadcrumbJsonLd, faqJsonLd } from "@/lib/structuredData";

const ASSET = "/masterclass/nelson";
// Profile photos + shared closing-pitch ticket image live in /lokesh/
const SHARED = "/masterclass/lokesh";

// Real Wikipedia-sourced posters of Nelson's four films. The earlier
// build used film stills (BTS-looking shots), which the user flagged.
// These vertical 2:3 posters read as posters at any size.
const POSTER_KOKILA = `${ASSET}/kolamaavu-kokila-poster.jpg`;
const POSTER_DOCTOR = `${ASSET}/doctor-poster.jpg`;
const POSTER_BEAST  = `${ASSET}/beast-poster.jpg`;
const POSTER_JAILER = `${ASSET}/jailer-poster.jpg`;

// Episode list. Em-dashes replaced with periods or commas (the page
// previously used em-dashes everywhere; the user flagged this as
// reading like AI-generated copy). Titles are kept in title-case so
// they pair naturally with the accordion's italic display style.
const episodes = [
  { number: 1,  title: "Foundations of a Filmmaking Journey",                       description: "Meet your award-winning mentor. Nelson lays out the goals of the masterclass and shares the experiences, mistakes, and personal truths that shaped his films. Take notes, but trust your gut." },
  { number: 2,  title: "Lessons from an Accidental Filmmaker",                      description: "Filmmaking wasn't Nelson's childhood dream. A twist of fate, a low engineering score, and his father's quiet creativity steered him into cinema almost by accident." },
  { number: 3,  title: "Finding Your Voice",                                        description: "How do you recognise your creative spark? Nelson reflects on photography, college storytelling contests, and the process of finding a voice you can actually trust on set." },
  { number: 4,  title: "Learning to See the World Differently",                     description: "Nelson didn't go to film school. He explains how curiosity, observation, and hanging out with peers sharpened his visual storytelling, and how you can borrow the same habit." },
  { number: 5,  title: "Watching Cinema with a Filmmaker's Eye",                    description: "Go beyond passive watching. Frame composition, editing rhythm, visual metaphor. Nelson breaks down how he absorbs a film and what he steals from it." },
  { number: 6,  title: "Structuring Stories from the Masters",                      description: "Build narrative frameworks the way Nelson does. He shares foundational script lessons inspired by iconic Tamil directors, with tools you can apply to your own outline today." },
  { number: 7,  title: "Story Over Stardom: Kolamaavu Kokila",                      description: "Kolamaavu Kokila was a woman-led story Nelson made before chasing a star. He breaks down the choice and what it taught him about story-first thinking." },
  { number: 8,  title: "Trusting Your Instincts",                                   description: "What makes your films different from everyone else's? Nelson shares the way he separates his sensibilities from industry noise, and how to keep them when budgets get bigger." },
  { number: 9,  title: "Real Observations, Relatable Stories",                      description: "A chance encounter with a woman whose actions contradicted her appearance became the seed of Kolamaavu Kokila. Nelson shows you how to mine your own life for cinema." },
  { number: 10, title: "Tonal Balance: The Doctor Approach",                        description: "Doctor's tone was tricky. Nelson explains how he mixed dark humour with tension without losing emotional weight, and what to do when a tone won't sit still." },
  { number: 11, title: "Previsualisation: Seeing the Film Before You Shoot",        description: "Narration isn't just storytelling. It's how you make an audience feel what you feel. Nelson walks through the way he visualises scenes long before the camera rolls." },
  { number: 12, title: "Guiding New Actors",                                        description: "Nelson prefers fresh actors over familiar faces. He reveals the simple, direct communication that pulls natural performances out of inexperienced talent." },
  { number: 13, title: "Five Lines First",                                          description: "Nelson begins simply: just five lines that capture his core idea. Learn the \"Five Lines First\" method and how to distil your film into beats before layering complexity." },
  { number: 14, title: "Getting Unstuck",                                           description: "Writer's block hits Nelson often. He admits it openly and shares the simple fix: breaking scenes down piece by piece, pacing carefully, keeping audiences glued." },
  { number: 15, title: "Building Complex Characters in Beast",                      description: "How Veera Raghavan was built. Open with action, add emotional depth, tap the character's guilt. Nelson breaks down the layered design behind his Beast lead." },
  { number: 16, title: "Making Mass Moments Matter",                                description: "How do you build scenes everyone remembers? Nelson breaks down the timing, setup, and payoff that make a \"mass\" beat resonate emotionally, not just visually." },
  { number: 17, title: "Writing Transformational Arcs",                             description: "Nelson unpacks why \"flip\" moments are always audience favourites, using examples from Kolamaavu Kokila, Doctor, and Beast." },
  { number: 18, title: "The Hero's Journey, Restated",                              description: "What makes a hero's transformation powerful, even when you've seen it before? Nelson examines Jailer alongside classics like Baasha to show why timing and consistency matter." },
  { number: 19, title: "Writing Real Dialogue",                                     description: "Nelson tests lines aloud with his team to make sure they sound true and not forced. Each character speaks differently. It's a small habit with big payoff." },
  { number: 20, title: "Collaboration Without Losing Control",                      description: "How much feedback is too much? Nelson explains his balanced approach: accepting input openly, then filtering it through his instincts." },
  { number: 21, title: "Aligning Vision and Budget",                                description: "Nelson talks candidly about how budgets shape stories. Constraints lead to smarter decisions and tighter, more practical films." },
  { number: 22, title: "Scene Design Without Storyboards",                          description: "Nelson rejects storyboards. He starts from core scene concepts and co-develops set design with his art and camera teams for natural realism." },
  { number: 23, title: "Sets Built from Scripts",                                   description: "Every set Nelson builds is informed by the script. Wall heights, windows, even furniture come directly from what the scene needs." },
  { number: 24, title: "Keeping the Set Alive",                                     description: "Nelson keeps creative energy on set. How to preserve positivity and problem-solving energy during high-stress shoots." },
  { number: 25, title: "Communicating Clearly",                                     description: "Nelson leans on his assistant directors to communicate visual goals to every department. Clarity beats charisma every time." },
  { number: 26, title: "Stars and First-Timers, Same Direction",                    description: "Nelson directs stars and newcomers exactly the same way: clearly and directly. He explains how he pulled a strong performance from Dhanraj in Jailer." },
  { number: 27, title: "Editing with Rhythm and Honesty",                           description: "Editing isn't trimming. Nelson describes finding the story's heartbeat through trial screenings and honest feedback to land the cleanest version." },
  { number: 28, title: "When Music Leads the Scene",                                description: "Music isn't background for Nelson; it guides scenes. He describes working closely with composer Anirudh Ravichander on tense moments in Kolamaavu Kokila." },
  { number: 29, title: "Performance and Visuals on Set",                            description: "On set, Nelson focuses on visuals and performances, trusting his preparation to guide him through each take." },
];

// Why-this-masterclass-for-you points. Em-dashes replaced. The third
// item's video asset was flagged as wrong. Swapping to the unused
// OucYYwMeD8KJ3L2Ym5QjMsqFy8.mp4 clip so the section reads correctly.
const whyPoints = [
  { text: "He rewrote the rules without going to film school. Watch how a self-taught director thinks his way into the industry.", media: `${ASSET}/PkzuGlqlj42UhIDTJauJYKTiw.mp4` },
  { text: "Calm direction with stars and newcomers. The same simple language gets a real performance out of either.",              media: `${ASSET}/d5LHXpALRFkIVI9VBrbPyRtxuV8.mp4` },
  { text: "Dark humour and tension, balanced. Nelson's signature tonal mix and how he keeps it from collapsing on screen.",        media: `${ASSET}/OucYYwMeD8KJ3L2Ym5QjMsqFy8.mp4` },
];

// Testimonials. Em-dashes removed. ★★★★★ rendered above each name on
// the carousel card itself (the carousel component handles this via
// the new `rating` field).
const testimonials = [
  {
    name: "Ananya Rao",
    role: "Screenwriting Student, Mumbai",
    rating: 5,
    quote: "I was halfway through my second short, completely stuck. Nelson's \"Five Lines First\" idea is so simple it almost feels like a cheat. He's not selling a method, just showing how he begins. After that module I rewrote my opening scene the same evening.",
    image: `${SHARED}/7hJXjAnFQFhrHeIHhWAx3PQ17E.png`,
  },
  {
    name: "Shiv Kumar",
    role: "Assistant Director, Hyderabad",
    rating: 5,
    quote: "Bro this is real talk. I've worked on sets with ADs screaming and actors lost. Nelson's vibe is the opposite. Calm, direct, ridiculously specific. When he explains how he gets performances out of newcomers, you realise you've been overcomplicating it. This won't give you a shot list. It gives you sanity.",
    image: `${SHARED}/c6YH9xoHd2ETCvdfslf2Fh2ak.jpg`,
  },
  {
    name: "Deepak V",
    role: "Mass Comm Student, Chennai",
    rating: 5,
    quote: "In college they keep throwing theory at us. Nelson just talks about why he did something a certain way. His Kolamaavu Kokila breakdown is gorgeous. I watched it twice, then opened my own script and made changes the same night. I'm learning more here than in a full semester.",
    image: `${SHARED}/vtsct4yeHdQKJcFLxyEhRk40iKk.jpg`,
  },
];

// What you'll get cards. Em-dashes purged.
const whatYouGet = [
  { num: "01", title: "Inside Nelson's craft",         description: "How he builds suspense, humour, and tone across a film without breaking the audience contract." },
  { num: "02", title: "29 episodes, around 2h 20m",    description: "From script to screen, mapped through his own films. Watch in order or jump to what you need." },
  { num: "03", title: "Workbooks and exercises",       description: "Downloadable PDFs and case notes you can pin to your wall while you work on your own script." },
  { num: "04", title: "Certificate signed by Nelson",  description: "A digital certificate you can share online or on your portfolio after you finish the course." },
];

// FAQ. Em-dashes purged. Episode count corrected to 29. Refund/
// download/vs-film-school questions retained from the CRO HANDOFF doc.
const faqs = [
  { question: "How long is the course?",                      answer: "29 video lessons with Nelson Dilipkumar, totalling roughly 2 hours 20 minutes of content. Watch at your own pace. Binge it in one weekend or take it slow, an episode a day." },
  { question: "What language is it in?",                      answer: "Lessons are in simple Tamil with English subtitles, in Nelson's natural conversational tone. Dubbed versions in Hindi, Telugu, Kannada and Malayalam are launching soon." },
  { question: "Do I need any filmmaking experience?",         answer: "Not at all. Whether you're a beginner, a student, or someone with zero experience, this course is for anyone curious about the why and how behind a good film. If you've ever watched a Nelson film and wondered how he pulled it off, this is where you'll find out." },
  { question: "Is there a money-back guarantee?",             answer: "Yes. We offer a 100% money-back guarantee. If the masterclass doesn't deliver value for you, write to us within the guarantee window and we'll refund the full amount with no questions asked." },
  { question: "Can I download the videos?",                   answer: "Videos are streaming-only and accessible through your LevelUp Learning account on any device. PDFs and case notes are downloadable, so you can keep those." },
  { question: "How is this different from a film school?",    answer: "A film school teaches a curriculum. This is Nelson's process, the way a working director thinks, decides, and builds. You're not memorising theory; you're sitting next to him while he walks through Kolamaavu Kokila, Doctor, Beast and Jailer and unpacks the choices behind every scene." },
  { question: "What do I get when I enrol?",                  answer: "29 lessons with lifetime access. A Certificate of Completion signed by Nelson Dilipkumar. Downloadable PDFs and case notes for every episode. Entry into our LevelUp creative community for discussions and events." },
  { question: "Is this a technical filmmaking course?",       answer: "No. Nelson isn't teaching shot sizes or camera gear. He shares how he makes films: process, instincts, decision-making, and the behind-the-scenes mindset across writing, direction, performance, and production." },
  { question: "Will I learn how to write or shoot scenes?",   answer: "Not in the textbook sense. You won't learn screenplay formatting or gear settings. You will learn how Nelson simplifies ideas, finds emotional arcs, trusts his gut while directing, and builds scenes that feel both grounded and larger than life." },
  { question: "I'm not from the film industry. Will it help?",answer: "Yes. Several learners come from non-filmmaking backgrounds (software, marketing, teaching) and find the course useful for understanding storytelling, structure, and creative thinking. If you love stories or run creative projects, you'll find value here." },
  { question: "Is this a one-time payment?",                  answer: "Yes. Pay ₹2,499 once for lifetime access. No renewals, no subscription, no recurring charges." },
];

const CTA_HREF = "https://study.leveluplearning.in/l/d10daddcf4";
const YT_TRAILER_ID = "km7nB-tf1FE";
const HERO_VIDEO = `${ASSET}/UXdMOLYeuSAuzIrrk2ruomgaGY.mp4`;
const HERO_POSTER = `${ASSET}/hQSDmaHN17ShD4VBcBY1eoRoX4.png`;
const CERT_IMG = `${ASSET}/hhKDd23mQMsXXKnKY7DFa92s.png`;
const CLAPPERBOARD_IMG = `${ASSET}/j5roAdkCE6j0M0Q1qn1OYJnB3c.png`;

// Specific learner counter (was a flat "18,000+"). The user wanted a
// real-feeling, oddly specific number. 18,466 reads as a counter
// snapshot rather than a marketing rounding. Date-stamp the line so a
// returning visitor doesn't see the same number forever.
const LEARNER_COUNT = "18,466";

const course = courseJsonLd({
  name: "Nelson Dilipkumar Filmmaking Masterclass",
  description: "Director of Kolamaavu Kokila, Doctor, Beast and Jailer. 29 episodes on writing, directing, and Nelson's calm-clarity craft. Tamil with English subtitles. Lifetime access. Certificate signed by Nelson Dilipkumar. ₹2,499.",
  path: "/masterclass/nelson-dilipkumar",
  instructorName: "Nelson Dilipkumar",
  image: HERO_POSTER,
  courseMode: "online",
});
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Masterclasses", path: "/" },
  { name: "Nelson Dilipkumar", path: "/masterclass/nelson-dilipkumar" },
]);
const faq = faqJsonLd(faqs);
---

<BaseLayout
  title="Nelson Dilipkumar Masterclass · LevelUp Learning"
  description="Director of Kolamaavu Kokila, Doctor, Beast and Jailer. 4 films, ₹1,250+ Cr at the box office, 6 years. 29 episodes on writing, directing, and Nelson's calm-clarity craft. Tamil with English subtitles. Certificate signed by Nelson. ₹2,499 (was ₹4,999)."
  path="/masterclass/nelson-dilipkumar"
  type="course"
  ogImage={HERO_POSTER}
  preloadImage={HERO_POSTER}
  jsonLd={[course, breadcrumb, faq]}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link rel="preconnect" href="https://www.youtube-nocookie.com" slot="head" />
  <link rel="preload" as="video" href={HERO_VIDEO} fetchpriority="high" slot="head" />

  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Cinzel:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap");

    .lokesh-page {
      --bg: #080604;
      --bg-card: #0F0B07;
      --bg-card-2: #1A130C;
      --bg-card-3: #241B14;
      --text: #ffffff;
      --text-dim: #dfdee2;
      --text-muted: #737373;
      --gold-1: #f5d59a;
      --gold-2: #d4a36c;
      --gold-3: #a06a36;
      --gold-text-on-pill: #2a1300;
      --course-accent: #0F4F4A;
      --course-accent-glow: rgba(15, 79, 74, 0.45);
      background: var(--bg);
      color: var(--text);
      font-family: "Inter", "Inter Placeholder", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-feature-settings: "ss01", "ss02";
      -webkit-font-smoothing: antialiased;
      padding-bottom: 88px;
    }
    @media (min-width: 768px) { .lokesh-page { padding-bottom: 0; } }
    .font-cinzel { font-family: "Cinzel", "Cinzel Placeholder", serif; }
    .font-cinzel-italic { font-family: "Cinzel", serif; font-style: italic; }

    .text-gold {
      background-image: linear-gradient(284deg, rgb(160, 106, 54) 0%, rgb(245, 213, 154) 50%, rgb(212, 163, 108) 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .lokesh-page .buy-pill {
      background: radial-gradient(120% 100% at 50% 0%, #ffe5b8 0%, #e3b671 30%, #c8924d 60%, #a87545 100%);
      color: var(--gold-text-on-pill);
      box-shadow: 0 14px 24px -8px rgba(200, 146, 77, 0.6), inset 0 1px 0 rgba(255, 230, 190, 0.85), inset 0 -1px 0 rgba(80, 35, 0, 0.4);
      font-family: "Inter", sans-serif; font-weight: 700; letter-spacing: 0;
      transition: filter 0.25s ease, transform 0.25s ease;
    }
    .lokesh-page .buy-pill:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .lokesh-page .buy-pill:active { transform: translateY(0); }
    .lokesh-page .star-bg {
      background-image:
        radial-gradient(rgba(255,255,255,0.10) 1px, transparent 1.5px),
        radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1.5px);
      background-size: 36px 36px, 88px 88px;
      background-position: 0 0, 18px 18px;
      animation: mc-stars 90s linear infinite;
    }
    @keyframes mc-stars {
      0%   { background-position: 0 0, 18px 18px; }
      100% { background-position: 360px 720px, 378px 738px; }
    }
    .lokesh-page .reveal { opacity: 1; transform: none; transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
    html.mc-js-on .lokesh-page .reveal { opacity: 0; transform: translateY(28px); }
    html.mc-js-on .lokesh-page .reveal.mc-in { opacity: 1; transform: translateY(0); }
    @media (prefers-reduced-motion: reduce) {
      html.mc-js-on .lokesh-page .reveal { opacity: 1 !important; transform: none !important; }
      .lokesh-page .star-bg,
      .lokesh-page .float-a,
      .lokesh-page .float-b,
      .lokesh-page .float-c,
      .lokesh-page .marquee-track,
      .lokesh-page .marquee-track-rev { animation: none !important; }
    }
    .lokesh-page .lift { transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease; will-change: transform; }
    .lokesh-page .lift:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -16px rgba(212, 163, 108, 0.25), 0 8px 24px -8px rgba(0, 0, 0, 0.7); border-color: rgba(212, 163, 108, 0.25); }
    html { scroll-behavior: smooth; }
    .lokesh-page .section-tick {
      display: inline-block; width: 1px; height: 24px;
      background: linear-gradient(180deg, transparent, #d4a36c, transparent);
      margin: 0 auto;
    }

    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .lokesh-page .marquee-track { animation: marquee 38s linear infinite; }
    .lokesh-page .marquee-track-rev { animation: marquee 42s linear infinite reverse; }

    @keyframes mc-float-a { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
    @keyframes mc-float-b { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
    @keyframes mc-float-c { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
    .lokesh-page .float-a { animation: mc-float-a 5.6s ease-in-out infinite; }
    .lokesh-page .float-b { animation: mc-float-b 7.2s ease-in-out infinite; }
    .lokesh-page .float-c { animation: mc-float-c 9.0s ease-in-out infinite; }

    @keyframes mc-clapper-rotate {
      from { transform: translate(-50%, -50%) rotate(0deg); }
      to   { transform: translate(-50%, -50%) rotate(360deg); }
    }
    .lokesh-page .mc-rotate-clapper { transform-origin: 50% 50%; animation: mc-clapper-rotate 28s linear infinite; }
    @media (prefers-reduced-motion: reduce) { .lokesh-page .mc-rotate-clapper { animation: none; } }

    @property --mc-cert-angle { syntax: "<angle>"; initial-value: 0deg; inherits: false; }
    @keyframes mc-cert-spin { from { --mc-cert-angle: 0deg; } to { --mc-cert-angle: 360deg; } }
    .lokesh-page .mc-cert-glow { position: relative; }
    .lokesh-page .mc-cert-glow::before {
      content: ""; position: absolute; inset: -2px;
      border-radius: 1.05rem; padding: 2px;
      background: conic-gradient(
        from var(--mc-cert-angle),
        rgba(212,163,108,0.0) 0deg, rgba(255,222,179,0.0) 60deg,
        rgba(245,213,154,1) 80deg, rgba(255,235,200,1) 90deg,
        rgba(245,213,154,1) 100deg, rgba(212,163,108,0.0) 120deg,
        rgba(212,163,108,0.0) 360deg
      );
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
      animation: mc-cert-spin 6s linear infinite;
      pointer-events: none; filter: drop-shadow(0 0 8px rgba(245,213,154,0.55));
    }
    @media (prefers-reduced-motion: reduce) { .lokesh-page .mc-cert-glow::before { animation: none; } }

    /* Orbit rings sized in % of the parent — switched from
       padding-bottom hack (which was producing oddly-shaped ovals on
       phone) to aspect-ratio so both rings stay perfectly circular at
       any screen size. */
    @keyframes mc-orbit-spin-a { from { transform: translate(-50%, -50%) rotate(0deg); }   to { transform: translate(-50%, -50%) rotate(360deg); } }
    @keyframes mc-orbit-spin-b { from { transform: translate(-50%, -50%) rotate(360deg); } to { transform: translate(-50%, -50%) rotate(0deg); } }
    .lokesh-page .mc-orbit-ring {
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      aspect-ratio: 1 / 1;
      border: 1px solid rgba(212,163,108,0.18);
      pointer-events: none;
    }
    .lokesh-page .mc-orbit-ring.outer { animation: mc-orbit-spin-a 60s linear infinite; }
    .lokesh-page .mc-orbit-ring.inner { animation: mc-orbit-spin-b 80s linear infinite; }
    @media (prefers-reduced-motion: reduce) {
      .lokesh-page .mc-orbit-ring.outer, .lokesh-page .mc-orbit-ring.inner { animation: none; }
    }

    .lokesh-page :focus { outline: none; }
    .lokesh-page a:focus-visible,
    .lokesh-page button:focus-visible,
    .lokesh-page [role="button"]:focus-visible,
    .lokesh-page input:focus-visible,
    .lokesh-page textarea:focus-visible,
    .lokesh-page select:focus-visible,
    .lokesh-page [tabindex]:focus-visible {
      outline: 2px solid #f5d59a;
      outline-offset: 2px;
      border-radius: 6px;
    }
    .lokesh-page .buy-pill:focus-visible,
    .lokesh-page .buy-pill-small:focus-visible {
      outline: 2px solid #f5d59a;
      outline-offset: 3px;
    }

    .lokesh-page .episode-title-italic { font-family: "Cinzel", serif; font-style: italic; font-weight: 500; }

    /* Real brand-logo trust strip. Each logo sits in a small white pill
       so the brand colours stay accurate against the dark page bg.
       Pills wrap; row stays compact at ~26px tall. */
    .lokesh-page .pay-logo {
      display: inline-flex; align-items: center; justify-content: center;
      height: 26px; padding: 0 8px;
      background: #ffffff;
      border-radius: 4px;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.25);
    }
    .lokesh-page .pay-logo img {
      display: block;
      height: 14px;
      width: auto;
      max-width: 60px;
      object-fit: contain;
    }
    /* A couple of logos read better with a tighter or looser height */
    .lokesh-page .pay-logo.tall img { height: 18px; }
    .lokesh-page .pay-logo.short img { height: 11px; }
  </style>

  <main id="main-content" class="lokesh-page">
    <StickyMobileCta href={CTA_HREF} price={2499} course="nelson-dilipkumar" />

    <!-- ─── Hero ───
         Mobile aspect compressed to 393/360 so H1 + sub + CTA + ★ + ₹
         all fit on a 375×667 phone above the fold. The HeroPlayer has
         been rebuilt to autoplay-immediately so the play-button flash
         + black-frame gap the user flagged are gone. -->
