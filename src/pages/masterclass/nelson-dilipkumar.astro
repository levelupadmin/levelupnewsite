---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EpisodeAccordion from "@/components/lokesh/EpisodeAccordion";
import FAQAccordion from "@/components/lokesh/FAQAccordion";
import TestimonialCarousel from "@/components/lokesh/TestimonialCarousel";
import LokeshTrailer from "@/components/lokesh/LokeshTrailer";
import PosterMarquee from "@/components/lokesh/PosterMarquee";
import HoverPlayVideo from "@/components/lokesh/HoverPlayVideo";
import IntersectionPlayVideo from "@/components/lokesh/IntersectionPlayVideo";
import PageInteractions from "@/components/lokesh/PageInteractions";
import { courseJsonLd, breadcrumbJsonLd, faqJsonLd } from "@/lib/structuredData";

const ASSET = "/masterclass/nelson";
// Profile photos are shared across masterclass pages — reuse from lokesh's already-deployed dir
const SHARED = "/masterclass/lokesh";

const episodes = [
  { number: 1, title: "Introduction — Foundations of Your Filmmaking Journey", description: "Meet your award-winning mentor Nelson who explains the goals of his MasterClass. Here he offers a peek behind the scenes, sharing the experiences, mistakes, and personal truths that shaped his movies. Take notes, but trust your gut." },
  { number: 2, title: "Redefining Career Paths — Lessons from an Accidental Filmmaker", description: "Filmmaking wasn't Nelson's childhood dream — it was barely on his radar. A twist of fate, a low engineering score, and his father's quiet creativity changed everything, steering him into cinema almost by accident." },
  { number: 3, title: "Finding Your Voice", description: "Learn how to recognize your creative spark through experimentation. Nelson reflects on how photography and college storytelling contests helped him develop a unique voice — an approach you can apply to your own evolution." },
  { number: 4, title: "Learning to See Your World Differently", description: "Explore how to develop a filmmaker's perspective without formal education. Nelson breaks down how curiosity, observational learning, and peer interaction helped him sharpen his visual storytelling and how you can too." },
  { number: 5, title: "Watching Cinema with a Filmmaker's Eye", description: "Go beyond passive film-watching. Nelson explains how analyzing frame composition, editing rhythm, and visual metaphors can transform how you absorb and apply cinematic language." },
  { number: 6, title: "Structuring Stories — Learning from Masters", description: "Understand how to build narrative frameworks. Nelson shares foundational script lessons inspired by iconic Tamil directors, giving you tools to simplify and strengthen your story architecture." },
  { number: 7, title: "Prioritizing Story over Stardom — Kolamavu Kokila", description: "Unpack how story-first thinking shapes powerful films. Nelson breaks down his decision to make a woman-led film without leaning on familiar hero tropes." },
  { number: 8, title: "Trusting Your Gut — Strengthening Creative Instincts", description: "What makes your films different from everyone else's? Learn how to identify and trust your filmmaking sensibilities, even when they go against the industry grain." },
  { number: 9, title: "Turning Real-Life Observations into Relatable Stories", description: "A chance encounter with a woman whose actions contradict her appearance became the foundation for Kolamavu Kokila. Discover how to ground your films in authenticity." },
  { number: 10, title: "Tonal Balancing — Doctor", description: "Nelson describes the tricky tone of his film Doctor. Learn how to mix unconventional tones without losing emotional weight — Doctor's humour remained engaging without compromising on tension." },
  { number: 11, title: "Previsualization — Seeing Your Story Before You Shoot", description: "Narration isn't just storytelling — it's how you make your audience feel what you feel. Explore how clearly visualizing your scenes can enhance emotional impact." },
  { number: 12, title: "Guiding New Actors — Techniques for Authentic Performances", description: "Nelson prefers new actors over familiar faces. He reveals how direct, simple communication helps him draw natural performances from inexperienced talent." },
  { number: 13, title: "Five Lines First — Building Stories from Core Concepts", description: "Nelson begins simply: just five clear lines to capture his core idea. Learn his \"Five Lines First\" method — distill your film into core beats before layering complexity." },
  { number: 14, title: "Getting Unstuck", description: "Writer's block hits Nelson often. He admits it openly, sharing his simple fix: breaking scenes down piece-by-piece, pacing carefully to keep audiences glued." },
  { number: 15, title: "Creating Complex Characters — The Making of Veera Raghavan (Beast)", description: "Nelson discusses building a layered character. Opening with action, adding emotional depth, and tapping into the character's guilt made Veera relatable and engaging from the start." },
  { number: 16, title: "Making Mass Moments Matter", description: "How do you build scenes everyone remembers? Learn how to craft \"mass\" scenes that resonate emotionally, not just visually. Discover timing, setup, and payoff strategies." },
  { number: 17, title: "Writing Transformational Arcs — The Power of Turning Points", description: "Nelson unpacks why transformation scenes — those big \"flip\" moments — are always audience favourites. Using Kolamavu Kokila, Doctor, and Beast." },
  { number: 18, title: "Hero's Journey — Jailer & Baasha", description: "What makes a hero's transformation powerful, even when you've seen it before? Nelson examines films like Jailer and classic hits like Baasha, showing why timing and emotional consistency make familiar arcs fresh." },
  { number: 19, title: "Writing Real Dialogue", description: "Nelson tests lines by speaking them aloud to his team, ensuring they sound true — not forced or overly dramatic. Each character speaks uniquely, making scenes authentic." },
  { number: 20, title: "Balancing Collaboration with Creative Control", description: "How much feedback is too much? Nelson explains his balanced approach — accepting input openly, but always filtering it through his instincts." },
  { number: 21, title: "Aligning Creative Vision with Production Budgets", description: "Nelson talks candidly about how budgets shape his stories. Learn how handling constraints can lead to smarter decisions, keeping stories focused and practical." },
  { number: 22, title: "Scene Design without Storyboards", description: "Nelson rejects storyboards. He starts from core scene concepts, collaborating closely with art and camera teams. Learn his method of co-developing set design for natural realism." },
  { number: 23, title: "Sets Built from Scripts", description: "Every set Nelson builds is strictly informed by the script. Wall heights, windows, even furniture — they all come directly from what the scene needs." },
  { number: 24, title: "Keeping the Set Alive", description: "Nelson shares how he maintains creative energy on set — preserving positivity and problem-solving energy during high-stress shoots." },
  { number: 25, title: "Communicating Clearly", description: "Nelson emphasizes clarity on set — relying heavily on assistant directors to communicate visual goals clearly to every department." },
  { number: 26, title: "The Art of Handling Stars & First-Timers", description: "Nelson directs big stars and fresh actors exactly the same way: clearly and directly. He explains how he drew a strong performance from newcomer Dhanraj in Jailer." },
  { number: 27, title: "Editing with Rhythm, Emotion, and Honesty", description: "Editing isn't just trimming footage — Nelson describes it as finding the story's heartbeat. Trial screenings and honest feedback to find the cleanest version." },
  { number: 28, title: "Music Leads the Way — Anirudh's Scores", description: "Music isn't just background for Nelson — it guides scenes. He describes working closely with composer Anirudh Ravichander on tense moments in Kolamavu Kokila." },
  { number: 29, title: "Prioritizing Performance and Visuals on Set", description: "On set, Nelson concentrates on visuals and performances, trusting his preparation to guide him through each take smoothly." },
];

const blockbusterFilms = [
  `${ASSET}/Du0bmXvfwK2WLbhbymBmcCdk.jpg`,
  `${ASSET}/KtbVjsCcNMvRhcGUeMA1qjBNkM.jpg`,
  `${ASSET}/d06YHadU02FdMU34DAg5Ntf3pnM.jpg`,
  `${ASSET}/f4PiQS7qDo1K6uyUMCZRKYIWNJ0.jpg`,
  `${ASSET}/kvLXSPFUspNyqa1n9Ak63OG1HU.jpg`,
  `${ASSET}/gdXjBShyQC6UQXPmLnW9vk9U2b4.jpeg`,
  `${ASSET}/hJ28OgAvMhmKSgk8IBvPAOV1q20.webp`,
  `${ASSET}/N3yEAJRMe6xkQEgS7kBbIAj9pEg.jpg`,
];

const whyPoints = [
  { text: "The Rulebreaker Director — Follow the journey of a director who rewrote the rules without ever going to film school.", media: `${ASSET}/PkzuGlqlj42UhIDTJauJYKTiw.mp4` },
  { text: "The Art of Calm Direction — Understand how to direct stars and first-timers with the same calm clarity.", media: `${ASSET}/d5LHXpALRFkIVI9VBrbPyRtxuV8.mp4` },
  { text: "Balancing Shadows and Laughter — Discover how to blend dark humor and tension in your storytelling.", media: `${ASSET}/P3suTJiRdyOPrFL3ZPrJDim04XU.mp4` },
];

const testimonials = [
  { name: "Ananya Rao", role: "Screenwriting Student, Mumbai", quote: "I'm in the middle of writing my second short, and this came at the right time. Nelson's process of starting with just five lines was so simple but powerful. He's not saying 'this is the method' — just how he begins. After that module, I finally got unstuck and rewrote my opening scene.", image: `${SHARED}/7hJXjAnFQFhrHeIHhWAx3PQ17E.png` },
  { name: "Shiv Kumar", role: "Assistant Director, Hyderabad", quote: "Bro this is real talk. I've worked on sets with ADs screaming and actors confused. But Nelson's vibe? Calm. Direct. And when he explains how he gets performances from newcomers, I realised I've been overcomplicating it. This masterclass won't give you a shot list — it'll give you sanity.", image: `${SHARED}/c6YH9xoHd2ETCvdfslf2Fh2ak.jpg` },
  { name: "Deepak V", role: "Mass Comm Student, Chennai", quote: "In college they keep throwing theory at us. Nelson just talks about why he did something a certain way. That Kolamavu Kokila breakdown? Beautiful. I watched it twice, then looked at my own script and made changes. I'm learning more here than in a full semester.", image: `${SHARED}/vtsct4yeHdQKJcFLxyEhRk40iKk.jpg` },
];

const whatYouGet = [
  { num: "01", title: "Insider Access to Nelson's Craft", description: "Understand how he builds suspense, humor, and tone in films." },
  { num: "02", title: "4+ Hours of In-Depth Lessons", description: "From script to screen, mapped through Nelson's career." },
  { num: "03", title: "Downloadable Workbooks & Exercises", description: "Practical assignments to hone your skills." },
  { num: "04", title: "Signed Certificate from Nelson Dilipkumar", description: "Showcase your new skills with pride." },
];

const faqs = [
  { question: "Is this a filmmaking course or a storytelling course?", answer: "This isn't a traditional filmmaking course. Nelson is not \"teaching\" filmmaking in the academic sense. Instead, he's sharing how he makes films — his process, instincts, decision-making, and behind-the-scenes mindset across writing, direction, performance, and production." },
  { question: "Do I need to have filmmaking experience to take this course?", answer: "Not at all. Whether you're a beginner, a student, or someone with zero experience, this course is for anyone curious about the why and how behind good films. If you've ever watched a Nelson film and thought, \"How did he pull that off?\" — this is where you'll find out." },
  { question: "Is it theory-heavy?", answer: "Nope. Nelson avoids jargon and textbook-style teaching. Instead, he walks you through real examples from his films — like Kolamavu Kokila, Doctor, Beast, and Jailer — and explains how each creative call came to be." },
  { question: "Can I access the course anytime?", answer: "Yes, once you buy it, you have lifetime access. Watch it anytime, anywhere, on any device." },
  { question: "Is this a one-time payment?", answer: "Yes. You pay once — ₹2,499 (offer price) — and it's yours forever. No hidden costs. No renewals." },
  { question: "How long is the course?", answer: "The course includes 29 video lessons with over 2 hours and 20 minutes of content. You can watch it at your own pace — binge it in one weekend or take it slow, episode by episode." },
  { question: "Is the content in English or Tamil?", answer: "The lessons are in simple Tamil, with English Subtitles. Dubbed versions for Telugu, Hindi, Kannada and Malayalam spoken in Nelson's natural tone will be available soon." },
  { question: "Will I get a certificate?", answer: "Yes, you'll receive a certificate of completion signed by Nelson Dilipkumar. You can download, print, or showcase it on LinkedIn and social media." },
  { question: "Will I learn how to write scripts or shoot scenes?", answer: "You won't learn screenwriting formats or camera operations here. But you will learn how Nelson simplifies ideas, finds emotional arcs, trusts his gut while directing, and builds scenes that feel both grounded and larger-than-life." },
  { question: "I'm not from the film industry. Will this still help me?", answer: "Absolutely. Several learners from non-filmmaking backgrounds — like software engineers, marketers, and teachers — have found this class useful for understanding storytelling, structure, and creative thinking. If you love stories or lead creative projects, you'll find value here." },
];

const CTA_HREF = "https://study.leveluplearning.in/l/d10daddcf4";
const YT_TRAILER_ID = "km7nB-tf1FE";
const HERO_VIDEO = `${ASSET}/UXdMOLYeuSAuzIrrk2ruomgaGY.mp4`;
const HERO_POSTER = `${ASSET}/hQSDmaHN17ShD4VBcBY1eoRoX4.png`; // 1058x622 — Nelson chair photo
const CERT_IMG = `${ASSET}/hhKDd23mQMsXXKnKY7DFa92s.png`; // certificate

const course = courseJsonLd({
  name: "Nelson Dilipkumar Filmmaking Masterclass",
  description: "Master storytelling and direction with Nelson Dilipkumar — the director behind Kolamaavu Kokila, Doctor, Beast, and Jailer. 29 episodes. Tamil with English subtitles. Signed Certificate. ₹2,499.",
  path: "/masterclass/nelson-dilipkumar",
  instructorName: "Nelson Dilipkumar",
  image: HERO_POSTER,
  courseMode: "online",
});
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Masterclasses", path: "/" },
  { name: "Nelson Dilipkumar", path: "/masterclass/nelson-dilipkumar" },
]);
const faq = faqJsonLd(faqs);
---

<BaseLayout
  title="Nelson Dilipkumar Masterclass — LevelUp Learning"
  description="Master storytelling and direction with Nelson Dilipkumar — director of Kolamaavu Kokila, Doctor, Beast, Jailer. 29 video lessons. Tamil with English subtitles. Signed Certificate. ₹2,499."
  path="/masterclass/nelson-dilipkumar"
  type="course"
  ogImage={HERO_POSTER}
  preloadImage={HERO_POSTER}
  jsonLd={[course, breadcrumb, faq]}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link rel="preconnect" href="https://www.youtube.com" slot="head" />

  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&family=DM+Sans:wght@400;500;600&display=swap");

    .lokesh-page {
      --bg: #050505;
      --bg-card: #0e0e0e;
      --text: #ffffff;
      --text-dim: #dfdee2;
      --text-muted: #737373;
      --gold-1: #f5d59a;
      --gold-2: #d4a36c;
      --gold-3: #8a5d2c;
      --gold-text-on-pill: #401b00;
      background: var(--bg);
      color: var(--text);
      font-family: "Inter", "Inter Placeholder", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-feature-settings: "ss01", "ss02";
      -webkit-font-smoothing: antialiased;
    }
    .font-cinzel { font-family: "Cinzel", "Cinzel Placeholder", serif; }
    .font-poppins { font-family: "Poppins", "Poppins Placeholder", sans-serif; }
    .font-dm { font-family: "DM Sans", "DM Sans Placeholder", sans-serif; }
    .text-gold {
      background: linear-gradient(180deg, #f5d59a 0%, #d4a36c 50%, #8a5d2c 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .lokesh-page .buy-pill {
      background: radial-gradient(120% 100% at 50% 0%, #ffe5b8 0%, #e3b671 30%, #c8924d 60%, #8c5e2e 100%);
      color: var(--gold-text-on-pill);
      box-shadow: 0 14px 24px -8px rgba(200, 146, 77, 0.6), inset 0 1px 0 rgba(255, 230, 190, 0.85), inset 0 -1px 0 rgba(80, 35, 0, 0.4);
      font-family: "Inter", sans-serif; font-weight: 700; letter-spacing: 0;
      transition: filter 0.25s ease, transform 0.25s ease;
    }
    .lokesh-page .buy-pill:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .lokesh-page .buy-pill:active { transform: translateY(0); }
    .lokesh-page .star-bg {
      background-image:
        radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
        radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      background-size: 36px 36px, 88px 88px;
      background-position: 0 0, 18px 18px;
    }
    .lokesh-page .reveal { opacity: 1; transform: none; transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
    html.mc-js-on .lokesh-page .reveal { opacity: 0; transform: translateY(28px); }
    html.mc-js-on .lokesh-page .reveal.mc-in { opacity: 1; transform: translateY(0); }
    @media (prefers-reduced-motion: reduce) { html.mc-js-on .lokesh-page .reveal { opacity: 1 !important; transform: none !important; } }
    .lokesh-page .lift { transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease; will-change: transform; }
    .lokesh-page .lift:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -16px rgba(212, 163, 108, 0.25), 0 8px 24px -8px rgba(0, 0, 0, 0.7); border-color: rgba(212, 163, 108, 0.25); }
    .lokesh-page .mc-hero-video { transform: scale(1.05); will-change: transform; }
    .lokesh-page .tilt { transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
    html { scroll-behavior: smooth; }
    .lokesh-page .section-tick {
      display: inline-block; width: 1px; height: 24px;
      background: linear-gradient(180deg, transparent, #d4a36c, transparent);
      margin: 0 auto;
    }
  </style>

  <main id="main-content" class="lokesh-page">
    <header class="relative z-30 px-5 md:px-12 pt-5 md:pt-7 flex items-center justify-between gap-4">
      <a href="/" class="inline-flex items-center" aria-label="LevelUp Learning home">
        <img src="/levelup-logo-mark.svg" alt="LevelUp" class="h-7 md:h-8 w-auto" />
      </a>
      <a href={CTA_HREF} target="_blank" rel="noopener noreferrer"
         class="hidden md:inline-flex buy-pill px-5 py-2.5 rounded-full text-[13px]">
        Enroll Now ₹2,499
      </a>
    </header>

    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="star-bg absolute inset-0 pointer-events-none opacity-60"></div>
      <div class="relative max-w-[1320px] mx-auto px-4 md:px-8 pt-3 md:pt-4">
        <div class="relative aspect-[16/10] md:aspect-[16/6.5] rounded-[10px] overflow-hidden bg-black ring-1 ring-white/[0.06]">
          <video src={HERO_VIDEO} poster={HERO_POSTER} muted loop playsinline autoplay preload="metadata"
                 class="absolute inset-0 w-full h-full object-cover"></video>
          <div class="absolute inset-x-0 bottom-0 h-[35%] bg-gradient-to-t from-black/55 to-transparent pointer-events-none"></div>
        </div>
        <div class="relative mt-5 md:mt-7 text-center max-w-3xl mx-auto pb-2 md:pb-4">
          <p class="text-[11px] md:text-[12px] tracking-[0.4em] uppercase text-[#dfdee2]/55 mb-3">Master Storytelling & Direction with</p>
          <h1 class="text-white text-[26px] md:text-[34px] lg:text-[42px] leading-[1.1] tracking-[-0.025em] font-semibold">
            <span class="text-gold font-cinzel">Nelson Dilipkumar</span>
          </h1>
          <p class="mt-4 md:mt-5 text-[14px] md:text-[15px] lg:text-[17px] leading-[1.55] tracking-[-0.02em] text-[#dfdee2]/75 max-w-[640px] mx-auto">
            The director behind Kolamaavu Kokila, Doctor, Beast, and Jailer in this exclusive masterclass. Learn how to blend dark humor, tension, and character in cinematic stories that stay with audiences.
          </p>
          <a href={CTA_HREF} target="_blank" rel="noopener noreferrer"
             class="buy-pill mt-6 md:mt-7 inline-flex items-center justify-center px-7 py-3 md:px-8 md:py-3.5 rounded-full text-[14px] md:text-[15px]">
            Join the Masterclass ₹2,499
          </a>
        </div>
      </div>
      <div class="h-10 md:h-16"></div>
    </section>

    <!-- Trailer -->
    <section class="relative px-5 md:px-12 pb-12 md:pb-20">
      <div class="max-w-[996px] mx-auto">
        <div class="relative rounded-[14px] overflow-hidden ring-1 ring-white/[0.07] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.7)]">
          <LokeshTrailer ytId={YT_TRAILER_ID} client:visible />
        </div>
      </div>
    </section>

    <!-- Class Info + Episodes -->
    <section class="relative px-5 md:px-12 py-14 md:py-24">
      <div class="max-w-[1180px] mx-auto">
        <div class="text-center mb-10 md:mb-14">
          <p class="font-cinzel text-[11px] md:text-[12px] tracking-[0.4em] uppercase text-[#dfdee2]/55">Class Info</p>
          <div class="my-4 section-tick"></div>
          <h2 class="font-cinzel text-gold text-[36px] md:text-[48px] lg:text-[60px] leading-[1] tracking-[-0.02em] font-semibold">CLASS INFO</h2>
          <p class="mt-3 text-[12px] md:text-[14px] tracking-[0.32em] uppercase text-[#dfdee2]/60">29 episodes</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-6 md:gap-8">
          <aside class="rounded-2xl border border-white/[0.08] bg-[#0E0E0E] p-7 md:p-8 h-fit lg:sticky lg:top-6">
            <p class="font-dm text-[18px] md:text-[20px] font-medium text-white tracking-[-0.04em]">Start today for just</p>
            <div class="mt-3 flex items-end gap-3">
              <span class="font-poppins text-[34px] md:text-[40px] font-semibold text-white tracking-[-0.06em] leading-none">₹2,499</span>
              <span class="text-[20px] md:text-[24px] text-[#9e9e9e] line-through tracking-[-0.06em] pb-1">₹4,999</span>
            </div>
            <a href={CTA_HREF} target="_blank" rel="noopener noreferrer"
               class="buy-pill mt-5 inline-flex w-full items-center justify-center px-5 py-3 rounded-full text-[14px]">
              Get It All for Just ₹2,499
            </a>
            <p class="mt-3 text-[14px] text-[#dfdee2]/80 text-center tracking-[-0.06em]">Limited Time Offer</p>
            <hr class="my-6 border-white/[0.08]" />
            <p class="text-[18px] md:text-[20px] font-medium text-[#dfdee2] tracking-[-0.06em]">What You'll Get?</p>
            <ul class="mt-4 space-y-3 text-[14px] md:text-[15px] text-white/85">
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>29 Practical Lessons</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>PDF Worksheets for Every Class</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>Certificate Signed by Nelson</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>Beginner-Friendly. No Prior Experience Needed</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>Learn Anytime, Anywhere</span></li>
            </ul>
          </aside>
          <div>
            <EpisodeAccordion episodes={episodes} initialVisible={5} client:visible />
          </div>
        </div>
      </div>
    </section>

    <!-- Director / Blockbuster films — circular ribbon of 12 posters around
         a centered text overlay. Matches Framer's "3D Space" composition. -->
    <section class="relative px-5 md:px-12 py-16 md:py-24 overflow-hidden">
      <div class="relative max-w-[1280px] mx-auto aspect-[16/13] md:aspect-[16/8]">
        {[...blockbusterFilms, ...blockbusterFilms].slice(0, 12).map((src, i) => {
          const angle = (i / 12) * Math.PI * 2 - Math.PI / 2;
          const cx = 50, cy = 50, rx = 40, ry = 36;
          const left = cx + rx * Math.cos(angle);
          const top  = cy + ry * Math.sin(angle);
          return (
            <div
              class="absolute w-[14%] aspect-[3/4] rounded-md overflow-hidden ring-1 ring-white/[0.08] shadow-[0_15px_30px_-12px_rgba(0,0,0,0.7)]"
              style={`left: ${left}%; top: ${top}%; transform: translate(-50%, -50%) rotate(${(angle * 180) / Math.PI + 90}deg);`}
            >
              <img src={src} alt="Nelson Dilipkumar film poster" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
          );
        })}
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 text-center px-4 max-w-[440px]">
          <h2 class="font-cinzel text-gold text-[26px] md:text-[34px] lg:text-[42px] leading-[1.05] tracking-[-0.04em] font-semibold">
            Learn<br />from the
          </h2>
          <p class="text-white text-[22px] md:text-[30px] lg:text-[38px] leading-[1.1] tracking-[-0.05em] font-semibold mt-2">
            Director Behind these Blockbuster Films
          </p>
