---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EpisodeAccordion from "@/components/lokesh/EpisodeAccordion";
import FAQAccordion from "@/components/lokesh/FAQAccordion";
import TestimonialCarousel from "@/components/lokesh/TestimonialCarousel";
import PosterMarquee from "@/components/lokesh/PosterMarquee";
import IntersectionPlayVideo from "@/components/lokesh/IntersectionPlayVideo";
import HeroPlayer from "@/components/lokesh/HeroPlayer";
import LokeshTrailer from "@/components/lokesh/LokeshTrailer";
import StickyMobileCta from "@/components/lokesh/StickyMobileCta.astro";
import CountdownTimer from "@/components/lokesh/CountdownTimer";
import PageInteractions from "@/components/lokesh/PageInteractions";
import { courseJsonLd, breadcrumbJsonLd, faqJsonLd } from "@/lib/structuredData";

const ASSET = "/masterclass/ravi";
const SHARED = "/masterclass/lokesh";

const episodes = [
  { number: 1, title: "From Basrur to Blockbusters: Discovering Musical Passions", description: "Dive into Ravi Basrur's inspiring journey from his humble beginnings in Basrur to creating chart-topping hits. Learn how his early passions ignited a trailblazing career in music composition and production." },
  { number: 2, title: "The Foundations: Unveiling the Magic of Music & Sound", description: "Master the foundational layers of music, from raw sound to organized composition, through Ravi's lens." },
  { number: 3, title: "Navigating Logic Pro X: Your Gateway to Composition", description: "Learn the workflow Ravi uses inside Logic Pro X to set up sessions, organize tracks, and start composing efficiently." },
  { number: 4, title: "Decoding Music Theory: Notes, Keys & The Art of Reverb", description: "Notes, keys, scales, and the surprisingly emotional weight of reverb. Theory made practical, the Basrur way." },
  { number: 5, title: "Frequency Fundamentals: Shaping the Soundscape", description: "Understand frequency ranges and how to shape them: what to cut, what to lift, how to make space in a mix." },
  { number: 6, title: "Elevating Audio: Mastering Plugins & Sound Design", description: "The plugin chain Ravi uses, and the sound-design philosophy behind picking each one." },
  { number: 7, title: "Crafting Epic Scores: Orchestration & Sound Mixing", description: "How Ravi layers orchestration with cinematic mixing decisions to land an emotional punch in films like KGF." },
  { number: 8, title: "Inside KGF: Mastering Transitions & Vocal Solos", description: "Walk through the iconic KGF transitions and vocal-solo moments: what worked, what was scrapped, and why." },
  { number: 9, title: "Precision in Pitch: Advanced Techniques & Essential Plugins", description: "Pitch-shifting, tuning, and the plugins that turn rough takes into polished moments without killing emotion." },
  { number: 10, title: "Symphonic Synergy: Voices & Live Instruments in Sound Design", description: "How to weave voices and live instruments into electronic textures so the whole feels organic, not stitched." },
  { number: 11, title: "Organizing for Success: Optimizing Your Music Library", description: "The library structure Ravi uses to find any sample in seconds: naming, tagging, and folder hygiene." },
  { number: 12, title: "Narrative through Notes: The Art of Musical Storytelling", description: "Music as story: motifs, callbacks, and the way Ravi shapes a film's emotion through repeated melodic ideas." },
  { number: 13, title: "Bonus Episode: The Musical Journey, Overcoming Struggles to Success", description: "Personal struggles, near-failures, and the inflection points that turned Ravi from village musician into India's most-watched composer." },
  { number: 14, title: "Turning Points: Embracing a New Identity in Music", description: "The mindset shifts behind a successful re-invention, and how to find your own next phase." },
  { number: 15, title: "From Jingles to Albums: Crafting Music for All Mediums", description: "Why every medium has its own grammar (jingles, scores, albums) and how to switch fluently between them." },
  { number: 16, title: "Live Case Studies & Q&A", description: "Live walk-throughs of selected film score moments with Q&A on every choice. The closest you'll get to sitting in Ravi's studio." },
];

// All Ravi Basrur film posters available in /public/masterclass/ravi/.
// Includes KGF, Salaar, Mufti, Ugramm, Marco, Pailwaan, Hebbuli, plus
// other notable scores. The 5 entries below the original 8 are added
// from previously-unused JPGs in the assets folder. Please verify each
// is actually a Ravi-Basrur film poster (and not a Framer chrome
// asset) and drop any that aren't.
const blockbusterFilms = [
  `${ASSET}/gy5ZUwVDsh5DmL62fuECONTPer4.jpg`,
  `${ASSET}/tgFOH8jiflFh4LVxQEfkicZBYN0.jpg`,
  `${ASSET}/rwAOA0eLNkLWVydIJRAKj7W6vc.jpg`,
  `${ASSET}/D4KluUHGAVOfzb8YZnMtZerko.jpg`,
  `${ASSET}/84SBoHO3pso5uCkalOBtBhFCII.jpg`,
  `${ASSET}/fRkyaqzCVbqgsByfhLEhQJDYCA.jpg`,
  `${ASSET}/qcYjx7nLO25XAdIqO44V8nWg9o.jpg`,
  `${ASSET}/GJkSCN3Qx9AOYyfB46Nfu7t62Kc.jpg`,
  `${ASSET}/aJuNFM3yrWoaK8mS5UDkiWKvZMU.jpg`,
  `${ASSET}/ePirkCFciEHXunwJqziiB4axuRg.jpg`,
  `${ASSET}/RfVCRR3DN4gBmYKOoGeAzUrkk.jpg`,
  `${ASSET}/zFmHfnlQkxKB4uCVGAzeSMu8.jpg`,
  `${ASSET}/84vqMJpjPxiDxqgs8idjMvDlaBc.jpg`,
];

// Split into two rows so each marquee shows a different set instead of
// the same posters duplicated.
const filmsRowA = blockbusterFilms.slice(0, 7);
const filmsRowB = blockbusterFilms.slice(7);

const whyPoints = [
  { text: "Learn how to score impactful background scores along with live case-study examples from his movies", media: `${ASSET}/HpvAYfNv0ZspXfBBvnAgr7J4s.mp4` },
  { text: "Gain deep insights into rhythm, orchestra, sound design, and music software like Logic Pro X, plugins, and pitch correction techniques.", media: `${ASSET}/GNoqdoWaGsDBtAWE8gYgRW7slh8.mp4` },
  { text: "Master the art of audio production through exploring every aspect of music theory, orchestration, composition, sound mixing", media: `${ASSET}/eku81B8IYyORWwizqslYPVYP0GM.mp4` },
];

const testimonials = [
  { name: "Swetha", role: "Keyboard Artist", quote: "Ravi Basrur's masterclass has been a transformative journey into the heart of music composition. His ability to share insights from his illustrious career, coupled with live case studies, is unparalleled. As an aspiring composer, I found his teachings not only enlightening but also immensely practical.", image: `${SHARED}/7hJXjAnFQFhrHeIHhWAx3PQ17E.png` },
  { name: "Prem Kumar", role: "Music Director", quote: "Ravi Basrur's masterclass goes beyond the ordinary, offering a profound exploration of music that transcends boundaries. As an intermediate musician, I was pleasantly surprised by the depth of knowledge shared. The downloadable resources and case studies have proven to be invaluable tools for refining my craft.", image: `${SHARED}/c6YH9xoHd2ETCvdfslf2Fh2ak.jpg` },
  { name: "Gokulnath", role: "Aspiring Music Director", quote: "Enrolling in Ravi Basrur's masterclass was like unlocking the secrets of a musical maestro. Even as a professional in the industry, I gained fresh perspectives on composition and witnessed the genius behind chart-topping hits. The class is a treasure trove of practical tips.", image: `${SHARED}/vtsct4yeHdQKJcFLxyEhRk40iKk.jpg` },
];

const whatYouGet = [
  { num: "01", title: "Learn from the Best", description: "Hands-On Insights from Ravi Basrur." },
  { num: "02", title: "Creative Techniques", description: "Secrets of Music Theory, Orchestration & Sound Design." },
  { num: "03", title: "Case Studies", description: "Real life examples from Ravi Basrur's blockbuster hits." },
  { num: "04", title: "File Management", description: "Understand the concepts behind organizing music libraries & files." },
  { num: "05", title: "Tools & Pro Tips", description: "Demonstration of industry-standard tools & hacks." },
  { num: "06", title: "Personal Tips", description: "Gain knowledge from Ravi's personal experiences & success stories." },
];

// Outcome strip (CRO P2 from the audit). Frames transformation rather
// than features. Pulled from the episode content: scoring, Logic Pro X
// workflow, orchestration with electronic textures, library hygiene.
const outcomes = [
  { title: "Score cinematic moments", description: "Build film scores that drive emotion the way KGF, Mufti, and Salaar do." },
  { title: "Run Logic Pro X end-to-end", description: "Compose, layer, mix, and master inside Logic with Ravi's exact session setup." },
  { title: "Layer orchestra + electronic", description: "Blend live instruments and electronic textures so they feel organic, not stitched." },
  { title: "Build a sustainable library", description: "Organise samples, plugins, and presets so you can find anything in seconds." },
];

// FAQs repositioned for a general audience. The class isn't only for
// musicians, it's for anyone curious about how music shapes a film.
// Beginner-first question goes first.
const faqs = [
  { question: "I don't know anything about music. Would I benefit from this?", answer: "Absolutely. This masterclass was designed for anyone curious about how music shapes the films and stories we love. You don't need to read sheet music or own a keyboard. Ravi walks through how he thinks about emotion, rhythm, and storytelling in plain language. If you're a filmmaker, an aspiring composer, or just someone who feels something when a great score hits, you'll find a lot to take home." },
  { question: "Who is this class for?", answer: "Filmmakers, aspiring filmmakers, aspiring music directors, sound designers, musicians at any level, and anyone fascinated by the role music plays in cinema. The class is intentionally accessible: you'll go deep on Ravi's process whether or not you can play an instrument." },
  { question: "I'm an intermediate or professional musician. Will I still learn something?", answer: "Yes. Ravi shares his real-world process (orchestration choices, sound-design tricks, and case studies from KGF, Mufti, Ugramm, Salaar, and Marco) that aren't usually taught anywhere. Even seasoned music directors have found new perspectives here." },
  { question: "What will I learn from this class?", answer: "How Ravi thinks about score and emotion, plus the practical craft: music theory in everyday terms, orchestration, composition, sound mixing and design, working with Logic Pro X, building a personal music library, and his end-to-end approach to scoring films from first idea to final mix. You'll see live case studies from his most-watched scores." },
  { question: "Will Ravi Basrur be teaching the class?", answer: "Yes. Every lesson is taught directly by Ravi himself, with examples drawn from his own work and explained in his natural voice." },
  { question: "Which language is the course in?", answer: "The lessons are in simple Tamil with English subtitles. Dubbed versions in Hindi, Telugu, Kannada and Malayalam will be available soon." },
  { question: "Are there any recurring costs to access the videos?", answer: "No. You pay once, ₹2,499, and get lifetime access. No subscription, no hidden charges, no renewals." },
  { question: "How long is the class?", answer: "16 video lessons, around 5 hours 10 minutes of content total. Watch at your own pace, revisit any time." },
  { question: "When do I get the signed certificate?", answer: "After you complete the course, you'll receive a personalized Certificate of Completion signed by Ravi Basrur, available to download and share." },
  { question: "Where can I watch these classes?", answer: "On any device (laptop, tablet, or phone) through the LevelUp Learning platform. Accessible 24/7 once you enroll." },
  { question: "Will I get a certificate for this masterclass?", answer: "Yes. A personalized Certificate of Completion signed by Ravi Basrur, downloadable as a PDF and shareable on social media or LinkedIn." },
];

const CTA_HREF = "https://app.leveluplearning.in/checkout/c95d0a25-b6a4-479c-a213-2c99cc2a57be";
const HERO_VIDEO = `${ASSET}/RBZ2T3tLoAhwvU5naq6vEJ6nM.mp4`;
const HERO_POSTER = `${ASSET}/h07QdqFzIWViBosJtyraHk8k1JI.png`;
const CERT_IMG = `${ASSET}/JnhTooO5upgRqxjjjelgU1IPHA.jpg`;
// youtu.be/r04WqxmwZZI — Ravi Basrur masterclass trailer.
const YT_TRAILER_ID = "r04WqxmwZZI";

const course = courseJsonLd({
  name: "Ravi Basrur Music Masterclass",
  description: "First-ever online masterclass with Ravi Basrur, the music director behind KGF, Mufti, Ugramm, and Salaar. 16 lessons covering composition, orchestration, sound design, and film scoring. Tamil with English subtitles. Signed Certificate. ₹2,499.",
  path: "/masterclass/ravi-basrur",
  instructorName: "Ravi Basrur",
  image: HERO_POSTER,
  courseMode: "online",
});
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Masterclasses", path: "/" },
  { name: "Ravi Basrur", path: "/masterclass/ravi-basrur" },
]);
const faq = faqJsonLd(faqs);
---

<BaseLayout
  title="Ravi Basrur Music Masterclass | LevelUp Learning"
  description="Learn film scoring with Ravi Basrur, music director of KGF, Mufti, Ugramm, Salaar. 16 video lessons. Tamil with English subtitles. Signed Certificate. ₹2,499 lifetime access."
  path="/masterclass/ravi-basrur"
  type="course"
  ogImage="/og/mc-ravi-basrur.jpg"
  preloadImage={HERO_POSTER}
  jsonLd={[course, breadcrumb, faq]}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />

  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&family=DM+Sans:wght@400;500;600&display=swap");
    .lokesh-page {
      --bg: #050505; --bg-card: #0e0e0e; --gold-text-on-pill: #401b00;
      background: var(--bg); color: white;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .font-cinzel { font-family: "Cinzel", serif; }
    .font-poppins { font-family: "Poppins", sans-serif; }
    .font-dm { font-family: "DM Sans", sans-serif; }
    .text-gold { background: linear-gradient(180deg, #f5d59a 0%, #d4a36c 50%, #8a5d2c 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .lokesh-page .buy-pill {
      background: radial-gradient(120% 100% at 50% 0%, #ffe5b8 0%, #e3b671 30%, #c8924d 60%, #8c5e2e 100%);
      color: var(--gold-text-on-pill);
      box-shadow: 0 14px 24px -8px rgba(200,146,77,0.6), inset 0 1px 0 rgba(255,230,190,0.85);
      font-weight: 700; transition: filter 0.25s, transform 0.25s;
    }
    .lokesh-page .buy-pill:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .lokesh-page .star-bg { background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px), radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 36px 36px, 88px 88px; }
    .lokesh-page .reveal { opacity: 1; transform: none; transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
    html.mc-js-on .lokesh-page .reveal { opacity: 0; transform: translateY(28px); }
    html.mc-js-on .lokesh-page .reveal.mc-in { opacity: 1; transform: translateY(0); }
    @media (prefers-reduced-motion: reduce) { html.mc-js-on .lokesh-page .reveal { opacity: 1 !important; transform: none !important; } }
    .lokesh-page .lift { transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease; will-change: transform; }
    .lokesh-page .lift:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -16px rgba(212, 163, 108, 0.25), 0 8px 24px -8px rgba(0, 0, 0, 0.7); border-color: rgba(212, 163, 108, 0.25); }
    .lokesh-page .mc-hero-video { transform: scale(1.05); will-change: transform; }
    .lokesh-page .tilt { transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
    html { scroll-behavior: smooth; }
    .lokesh-page .section-tick { display: inline-block; width: 1px; height: 24px; background: linear-gradient(180deg, transparent, #d4a36c, transparent); margin: 0 auto; }
  </style>

  <main id="main-content" class="lokesh-page">
    <StickyMobileCta href={CTA_HREF} price={2499} course="ravi-basrur" />

    <header class="relative z-30 px-5 md:px-12 pt-5 md:pt-7 flex items-center justify-between gap-4">
      <a href="/" aria-label="LevelUp Learning home"><img src="/levelup-logo-mark.svg" alt="LevelUp" class="h-7 md:h-8 w-auto" /></a>
      <a href={CTA_HREF} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex buy-pill px-5 py-2.5 rounded-full text-[13px]">Buy now at ₹2,499</a>
    </header>

    <section class="relative overflow-hidden">
      <div class="star-bg absolute inset-0 pointer-events-none opacity-60"></div>
      <div class="relative max-w-[1320px] mx-auto px-4 md:px-8 pt-3 md:pt-4">
        <div class="relative aspect-[16/9] md:aspect-[16/7.8] rounded-[10px] overflow-hidden bg-black ring-1 ring-white/[0.06]">
          <HeroPlayer src={HERO_VIDEO} poster={HERO_POSTER} ariaLabel="Play Ravi Basrur masterclass hero" client:load />
          <div class="absolute inset-x-0 bottom-0 h-[35%] bg-gradient-to-t from-black/55 to-transparent"></div>
        </div>
        <div class="relative mt-5 md:mt-7 text-center max-w-3xl mx-auto pb-2 md:pb-4">
          <h1 class="font-cinzel text-gold text-[28px] md:text-[40px] lg:text-[52px] leading-[1.05] tracking-[-0.04em] font-semibold">
            LEARN MUSIC COMPOSITION WITH RAVI BASRUR
          </h1>
          <p class="mt-5 md:mt-6 text-[15px] md:text-[17px] lg:text-[19px] leading-[1.5] tracking-[-0.02em] text-[#dfdee2]/85 max-w-[680px] mx-auto font-medium">
            From a village in Basrur to scoring KGF, Salaar, Mufti, Ugramm, and Marco. The music director behind India's biggest film soundscapes walks through his entire process.
          </p>
          <p class="mt-3 md:mt-4 text-[13px] md:text-[15px] leading-[1.55] tracking-[-0.01em] text-[#dfdee2]/65 max-w-[620px] mx-auto">
            16 lessons. 5 hours 10 minutes. Whether you're a filmmaker, an aspiring composer, or just someone who loves how a great score makes you feel, this is the room you want to be in.
          </p>

          {/* Trust strip: social proof above the fold. (CRO P1 from audit) */}
          <div class="mt-5 md:mt-6 text-[12px] md:text-[13px] text-white/70 leading-[1.6]">
            <span class="text-amber-300/95 tracking-tight align-middle mr-1.5" aria-hidden="true">★★★★★</span>
            <span class="font-semibold text-white align-middle">Rated 4.8 out of 5</span>
            <span class="align-middle"> · <span class="font-semibold text-white">15,000+ enrolled</span> · Lifetime access</span>
            <span class="block mt-1 text-[11px] md:text-[12px] tracking-[0.18em] uppercase text-white/55">KGF · Salaar · Mufti · Marco</span>
          </div>

          <div class="mt-6 md:mt-7 flex flex-col items-center gap-2">
            <a href={CTA_HREF} target="_blank" rel="noopener noreferrer" data-mc-hero-cta="true" class="buy-pill inline-flex items-center justify-center px-7 py-3 md:px-8 md:py-3.5 rounded-full text-[14px] md:text-[15px]">
              Buy now at ₹2,499
            </a>
            <p class="text-[12px] md:text-[13px] text-white/60">
              <span class="line-through decoration-[1.5px] decoration-white/40 mr-1.5">₹4,999</span>
              <span class="text-amber-300/95 font-semibold">Save ₹2,500</span>
              <span class="text-white/40 mx-1.5">·</span>
              <span>One-time payment, no subscription</span>
            </p>
          </div>
        </div>
      </div>
      <div class="h-10 md:h-16"></div>
    </section>

    {/* Trailer: YouTube embed. Replace YT_TRAILER_ID at the top of the
        page with the actual Ravi Basrur masterclass YouTube ID. */}
    <section class="relative px-5 md:px-12 pb-12 md:pb-20">
      <div class="max-w-[996px] mx-auto">
        <div class="relative rounded-[14px] overflow-hidden ring-1 ring-white/[0.07] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.7)]">
          <LokeshTrailer ytId={YT_TRAILER_ID} client:load />
        </div>
      </div>
    </section>

    {/* Class Info + Episodes. Dropped the duplicate "Class Info" eyebrow
        that repeated the H2 directly underneath. */}
    <section class="relative px-5 md:px-12 py-14 md:py-24">
      <div class="max-w-[1180px] mx-auto">
        <div class="text-center mb-10 md:mb-14">
          <h2 class="font-cinzel text-gold text-[36px] md:text-[48px] lg:text-[60px] leading-[1] tracking-[-0.02em] font-semibold">Class Info</h2>
          <p class="mt-3 text-[12px] md:text-[14px] tracking-[0.32em] uppercase text-[#dfdee2]/60">16 video lessons · 5h 10mins</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-6 md:gap-8">
          <aside class="rounded-2xl border border-amber-200/15 bg-[#0E0E0E] p-7 md:p-8 h-fit lg:sticky lg:top-6">
            <p class="font-dm text-[16px] md:text-[18px] font-medium text-white/85 tracking-[-0.02em]">Start your journey for just</p>
            <div class="mt-3 flex items-baseline gap-3">
              <span class="font-poppins text-[44px] md:text-[56px] font-bold text-white tracking-[-0.04em] leading-none">₹2,499</span>
              <span class="text-[20px] md:text-[24px] text-white/40 line-through decoration-amber-300/70 decoration-2 tracking-[-0.04em]">₹4,999</span>
            </div>
            <p class="mt-2 inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-amber-300/12 border border-amber-300/25 text-[11px] md:text-[12px] font-semibold tracking-tight text-amber-300/95">
              SAVE ₹2,500 · 50% OFF
            </p>
            <a href={CTA_HREF} target="_blank" rel="noopener noreferrer" class="buy-pill mt-5 inline-flex w-full items-center justify-center px-5 py-3.5 rounded-full text-[14px] md:text-[15px]">
              Buy now at ₹2,499
            </a>
            <div class="mt-3 flex justify-center">
              <CountdownTimer storageKey="ravi-countdown-v1" tone="alert" client:load />
            </div>
            <p class="mt-3 text-center text-[12px] text-white/55">One-time payment. No subscription, no renewal.</p>
            <hr class="my-6 border-white/[0.08]" />
            <p class="text-[18px] md:text-[20px] font-medium text-[#dfdee2] tracking-[-0.04em]">What You'll Get</p>
            <ul class="mt-4 space-y-3 text-[14px] md:text-[15px] text-white/85">
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>16 video lessons (5h 10mins)</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>Certificate signed by Ravi Basrur</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>Free access to Cine Circle community</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>100% money-back guarantee</span></li>
              <li class="flex items-start gap-3"><span class="text-[#d4a36c]">▸</span><span>No prior experience required</span></li>
            </ul>
          </aside>
          <div><EpisodeAccordion episodes={episodes} initialVisible={5} client:visible /></div>
        </div>
      </div>
    </section>

    {/* Films section: 2-row marquee carousel.
        Each row uses a unique subset (filmsRowA / filmsRowB) so the
        same poster never appears on both rows. The carousels scroll in
        opposite directions to suggest motion + depth. */}
    <section class="relative py-14 md:py-24 overflow-hidden">
      <div class="max-w-[1280px] mx-auto px-5 md:px-12 mb-10 md:mb-14">
        <h2 class="font-cinzel text-gold text-[28px] md:text-[36px] lg:text-[45px] leading-[1.05] tracking-[-0.06em] font-semibold">Learn from the</h2>
        <p class="text-white text-[28px] md:text-[40px] lg:text-[55px] leading-[1.05] tracking-[-0.06em] font-semibold mt-1 max-w-[900px]">Music Director Behind these Blockbuster Films</p>
        <p class="mt-5 md:mt-6 text-[14px] md:text-[16px] leading-[1.55] text-[#dfdee2]/75 max-w-[640px]">
          KGF Chapter 1 &amp; 2 · Salaar · Mufti · Ugramm · Marco · Pailwaan · Hebbuli · and more. A career spent writing the sound behind India's biggest films.
        </p>
