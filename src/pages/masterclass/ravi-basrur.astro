    cursor: pointer;
    list-style: none;
  }
  .bp-more > summary::-webkit-details-marker { display: none; }
  .bp-more > summary svg { transition: transform 0.3s ease; }
  .bp-more[open] > summary svg { transform: rotate(180deg); }
  .bp-more__close { display: none; }
  .bp-more[open] .bp-more__open { display: none; }
  .bp-more[open] .bp-more__close { display: inline; }
  .bp-more[open] > summary { margin-bottom: 10px; }

  .bp-cta-row { display: flex; flex-direction: column; align-items: center; gap: 12px; margin-top: 32px; text-align: center; }

  /* ── Films ── */
  .bp-films {
    list-style: none;
    margin: 0 calc(var(--mck-gutter, 20px) * -1);
    padding: 6px var(--mck-gutter, 20px) 18px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(140px, 42%);
    gap: 14px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--mck-gutter, 20px);
    scrollbar-width: none;
  }
  .bp-films::-webkit-scrollbar { display: none; }
  .bp-film { scroll-snap-align: start; transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--bp-i, 0) * 70ms); }
  html.mck-js .bp-films.mck-pending .bp-film { transform: translate3d(0, 28px, 0); }
  .bp-film__poster {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 12px;
    background: #15110c;
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 255, 255, 0.06);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }
  .bp-film__poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bp-film__title { margin: 12px 0 0; font-size: 15px; font-weight: 600; color: var(--bp-ink); }
  .bp-film__title span { margin-left: 4px; font-weight: 500; color: var(--bp-ink-3); }
  @media (min-width: 900px) {
    .bp-films {
      margin: 0;
      padding: 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      overflow: visible;
      gap: 18px;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .bp-film:hover .bp-film__poster {
      transform: translate3d(0, -6px, 0) rotate(-0.6deg);
      box-shadow: 0 34px 60px -26px rgba(212, 163, 108, 0.35), 0 0 0 1px rgba(245, 213, 154, 0.25);
    }
  }

  /* ── Certificate ── */
  .bp-cert {
    position: relative;
    max-width: 1000px;
    margin-inline: auto;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(245, 213, 154, 0.32);
    box-shadow: 0 50px 100px -50px rgba(212, 163, 108, 0.45);
  }
  .bp-cert img { display: block; width: 100%; height: auto; }
  .bp-cert::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 236, 200, 0.22) 50%, transparent 65%);
    transform: translate3d(-120%, 0, 0);
  }
  .bp-cert.mck-in::after { animation: bp-sweep 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.4s 1 both; }

  @keyframes bp-settle { from { transform: scale(1.06); } to { transform: scale(1); } }
  @keyframes bp-rise { from { transform: translate3d(0, 12px, 0); } to { transform: none; } }
  @keyframes bp-shine { from { background-position: 0% 50%; } to { background-position: 100% 50%; } }
  @keyframes bp-sweep { from { transform: translate3d(-120%, 0, 0); } to { transform: translate3d(120%, 0, 0); } }
  @media (prefers-reduced-motion: reduce) {
    .bp-hero__media img,
    .bp-hero__copy > *,
    .bp-h1__name,
    .bp-cert.mck-in::after { animation: none !important; }
    .bp-hero__media video { display: none; }
  }
</style>

<script>
  /*
   * Hero intro: the poster is the first paint. After the page has loaded,
   * the light intro cut for this screen size plays once and holds on its
   * last frame. Skipped for reduced motion, Save-Data and 2G links.
   */
  const box = document.querySelector<HTMLElement>("[data-hero-video]");
  const video = box?.querySelector("video");
  if (box && video) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const skip =
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      Boolean(conn?.saveData) ||
      /(^|-)2g$/.test(conn?.effectiveType ?? "");
    const start = () => {
      const src = window.matchMedia("(max-width: 767px)").matches ? box.dataset.srcM : box.dataset.srcD;
      if (!src) return;
      video.src = src;
      video.muted = true;
      video.addEventListener("playing", () => box.classList.add("is-playing"), { once: true });
      video.play()?.catch(() => {});
    };
    if (!skip) {
      if (document.readyState === "complete") window.setTimeout(start, 300);
      else window.addEventListener("load", () => window.setTimeout(start, 300), { once: true });
    }
  }
</script>

