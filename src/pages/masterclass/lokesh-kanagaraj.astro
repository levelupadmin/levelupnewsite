            <span class="text-[15px] md:text-[19px] text-[#f2f2f2] leading-[1.45] tracking-[-0.02em] font-medium">{t}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ─── Testimonials ─── -->
    <section class="relative px-5 md:px-12 py-16 md:py-24 overflow-hidden">
      <div class="max-w-[1100px] mx-auto text-center mb-12 md:mb-16 reveal">
        <p class="font-cinzel text-[11px] md:text-[12px] tracking-[0.4em] uppercase text-[#dfdee2]/55">Reviews</p>
        <div class="my-4 section-tick"></div>
        <h2 class="font-cinzel text-gold text-[24px] md:text-[34px] lg:text-[42px] leading-[1.1] tracking-[-0.04em] font-semibold">
          THIS MAKES OUR HEART BEAT FASTER EVERYDAY
        </h2>
      </div>
      <TestimonialCarousel items={testimonials} client:visible />
    </section>

    <!-- ─── What you'll get ───
         LEFT column ("What you'll get..." heading + copy + Buy now CTA)
         is `position: sticky` so it stays fixed at the top of the viewport
         while the user scrolls. The RIGHT column scrolls normally — the
         deal cards reveal one by one. After the last card (LCU Bonus
         Vault) is revealed, the sticky pin releases and BOTH the heading
         and the cards scroll up together as the user continues. -->
    <section class="relative px-5 md:px-12 py-16 md:py-24">
      <div class="max-w-[1180px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-start">
        {/* LEFT — sticky-pinned heading + copy + CTA. Sits at top:96px so
             it doesn't collide with any sticky page nav. The pin releases
             naturally when the parent grid row ends (after the last card
             on the right has scrolled past). */}
        <div class="reveal md:sticky md:top-24 self-start">
          <h2 class="font-cinzel text-gold text-[36px] md:text-[48px] lg:text-[60px] leading-[1.05] tracking-[-0.04em] font-semibold">
            What you'll get...
          </h2>
          <p class="mt-6 text-[18px] md:text-[22px] lg:text-[24px] leading-[1.45] tracking-[-0.04em] text-white max-w-[480px] font-medium">
            Enroll now and get bonuses worth Rs.19,999 for free. There was never a better time to grab this on-demand
            program.
          </p>
          <a
            href={CTA_HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="buy-pill mt-8 inline-flex items-center justify-center px-7 py-3 rounded-full text-[14px] md:text-[15px]"
          >
            Enrol — ₹1,499
          </a>
        </div>

        {/* RIGHT — deal cards in normal flow (no per-card sticky). They
             reveal in sequence as the user scrolls; the left column stays
             fixed thanks to its sticky positioning. The LCU Bonus Vault
             ends the sequence; after it scrolls past, the sticky pin
             releases and both columns continue together. */}
        <div class="space-y-5 md:space-y-6">
          {whatYouGet.map((g, i) => (
            <div
              class="rounded-xl border border-white/[0.10] bg-[#0E0E0E] p-5 md:p-6 lift flex gap-4 md:gap-5 reveal"
              style={`transition-delay: ${(i + 1) * 80}ms;`}
            >
              <span class="font-cinzel text-[32px] md:text-[44px] text-gold leading-none shrink-0">{g.num}</span>
              <div>
                <h3 class="text-[18px] md:text-[22px] font-semibold text-white leading-[1.25] tracking-[-0.04em]">{g.title}</h3>
                <p class="mt-1.5 text-[14px] md:text-[16px] text-[#a3a3a3] leading-[1.45]">{g.description}</p>
              </div>
            </div>
          ))}

          {/* LCU Bonus Vault — Wave 3 honesty pass: dropped the
               unsubstantiated "Worth ₹19,999" anchor and the
               unverifiable "first 100 enrollees" framing (the audit
               cross-validated both as red flags — no counter, no
               itemised breakdown, so they read as inflated). Replaced
               with what enrolment actually includes. */}
          <div class="rounded-xl border border-amber-200/30 bg-gradient-to-br from-[#1a1208] to-[#0a0604] p-6 md:p-7 reveal reveal-delay-4">
            <h3 class="font-cinzel text-gold text-[24px] md:text-[30px] lg:text-[40px] leading-[1.1] tracking-[-0.04em] font-semibold">The LCU Bonus Vault</h3>
            <p class="mt-3 text-[15px] md:text-[17px] leading-[1.5] tracking-[-0.01em] text-white/85">
              Included with enrolment: scene-breakdown PDFs, screenwriting
              worksheets, and the full LCU character-map archive.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Closing pitch — ticket card ───
         Framer renders this as a single horizontal "ticket" with rounded
         corners and perforation curves, the gold pitch text on the LEFT
         half and a row of 6 movie posters on the RIGHT half. We use the
         original ticket-shape PNG as a backdrop image and stack the
         posters / text on top with absolute layout. The whole ticket is
         capped at 1086px wide to match the source. -->
    <section class="relative py-16 md:py-24 px-5 md:px-12 overflow-hidden">
      <div class="relative w-full max-w-[1086px] mx-auto reveal">
        <!-- Ticket backdrop image -->
        <img
          src={`${ASSET}/lmCSmBU4Q2o6jwxi9ZTBSPAxnU.png`}
          alt=""
          class="block w-full h-auto select-none pointer-events-none"
          loading="lazy"
          decoding="async"
        />
        <!-- Overlay: text on the left half, poster strip on the right half -->
        <div class="absolute inset-0 grid grid-cols-1 md:grid-cols-[1.05fr_0.95fr] gap-4 md:gap-8 px-5 md:px-10 py-5 md:py-9">
          <div class="self-center">
            <h2 class="font-cinzel text-gold text-[18px] md:text-[26px] lg:text-[34px] leading-[1.05] tracking-[-0.04em] font-semibold max-w-[360px]">
              YOU'VE SEEN WHAT HE BUILDS ON SCREEN. NOW LEARN HOW HE BUILDS IT OFF SCREEN.
            </h2>
            <p class="mt-3 md:mt-5 text-[11px] md:text-[14px] leading-[1.5] tracking-[-0.02em] text-[#dfdee2]/80 max-w-[320px] hidden sm:block">
              If you're serious about filmmaking, this isn't just a class. It's a front-row seat to the thought process behind some of Indian cinema's boldest work.
            </p>
            <a
              href={CTA_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="buy-pill mt-4 md:mt-6 inline-flex items-center justify-center px-5 py-2.5 md:px-6 md:py-2.5 rounded-full text-[12px] md:text-[14px]"
            >
              Enrol — ₹1,499
            </a>
          </div>
          <!-- Right: TWO rows × THREE columns of movie posters laid out
               inside the ticket (matches the Framer screenshot exactly).
               Each poster has a subtle individual rotation/y-offset so
               they look like they were placed by hand on the ticket. The
               ticket image's right half is the canvas; we use absolute
               positioning to lock the posters inside it.
               Posters are static (no scroll) — matches Framer where the
               grid sits anchored. -->
          <div class="hidden md:grid grid-cols-3 grid-rows-2 gap-2 self-center pr-3 lg:pr-5">
            {[
              { src: blockbusterFilms[0], rot: -3, dy: -2 },
              { src: blockbusterFilms[1], rot: 1,  dy: 2 },
              { src: blockbusterFilms[2], rot: -1, dy: -3 },
              { src: blockbusterFilms[3], rot: 2,  dy: 3 },
              { src: blockbusterFilms[4], rot: -2, dy: -1 },
              { src: blockbusterFilms[5], rot: 3,  dy: 2 },
            ].map((p) => (
              <img
                src={p.src}
                alt=""
                class="w-full aspect-[2/3] object-cover rounded-md ring-1 ring-white/10 shadow-[0_10px_24px_-10px_rgba(0,0,0,0.85)]"
                style={`transform: translateY(${p.dy}px) rotate(${p.rot}deg);`}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        </div>
      </div>

      <!-- Mobile-only: poster marquee underneath the ticket since the
           ticket image is too narrow on phones for the 2×3 inline grid -->
      <div class="md:hidden mt-8 space-y-3">
        <PosterMarquee posters={blockbusterFilms} dir="left" speed={38} client:visible />
      </div>
    </section>

    <!-- ─── FAQ ─── -->
    <section class="relative px-5 md:px-12 py-16 md:py-28">
      <div class="max-w-5xl mx-auto text-center mb-12 md:mb-16 reveal">
        <p class="font-cinzel text-[11px] md:text-[12px] tracking-[0.4em] uppercase text-[#dfdee2]/55">Questions?</p>
        <div class="my-4 section-tick"></div>
        <h2 class="font-cinzel text-gold text-[36px] md:text-[48px] lg:text-[60px] leading-[1] tracking-[-0.06em] font-semibold">
          WE'VE GOT YOU COVERED!
        </h2>
        <a
          href={CTA_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class="buy-pill mt-8 inline-flex items-center justify-center px-7 py-3 rounded-full text-[14px] md:text-[15px]"
        >
          Enrol — ₹1,499
        </a>
      </div>
      <div class="max-w-5xl mx-auto reveal reveal-delay-2">
        <FAQAccordion faqs={faqs} courseName="Lokesh Kanagaraj Masterclass" client:visible />
      </div>
    </section>

    <!-- ─── Footer ─── -->
    <footer class="relative bg-[#181818] mt-12 md:mt-20 px-5 md:px-12 py-12 md:py-16">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 md:gap-12 items-center">
        <div class="text-center md:text-left">
          <p class="text-[14px] text-[#dfdee2] max-w-2xl leading-[1.6] tracking-[-0.02em]">
            LevelUp Learning is an e-learning platform focused on creative arts like music, science, sports,
            film-making and other such skill development disciplines. Students can access pre-recorded lectures or
            tutorials by experts in various fields.
          </p>
          <div class="mt-6 flex justify-center md:justify-start gap-5 text-white/70">
            <a href="https://www.instagram.com/levelup_learning/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.43.36 1.06.41 2.23.07 1.25.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.43.16-1.06.36-2.23.41-1.25.07-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.43-.36-1.06-.41-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.43-.16 1.06-.36 2.23-.41C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.15 0-3.52 0-4.76.06-1.07.05-1.65.23-2.04.38-.51.2-.88.44-1.27.83-.39.39-.63.76-.83 1.27-.15.39-.33.97-.38 2.04C2.66 8.48 2.66 8.85 2.66 12s0 3.52.06 4.76c.05 1.07.23 1.65.38 2.04.2.51.44.88.83 1.27.39.39.76.63 1.27.83.39.15.97.33 2.04.38 1.24.06 1.61.06 4.76.06s3.52 0 4.76-.06c1.07-.05 1.65-.23 2.04-.38.51-.2.88-.44 1.27-.83.39-.39.63-.76.83-1.27.15-.39.33-.97.38-2.04.06-1.24.06-1.61.06-4.76s0-3.52-.06-4.76c-.05-1.07-.23-1.65-.38-2.04a3.4 3.4 0 0 0-.83-1.27 3.4 3.4 0 0 0-1.27-.83c-.39-.15-.97-.33-2.04-.38C15.52 4 15.15 4 12 4zm0 3.07a4.93 4.93 0 1 1 0 9.86 4.93 4.93 0 0 1 0-9.86zm0 1.8a3.13 3.13 0 1 0 0 6.26 3.13 3.13 0 0 0 0-6.26zm5.13-2.27a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/levelup-learning/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM7.5 19h-3v-9h3v9zM6 8.7a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4zM20 19h-3v-4.7c0-1.1-.4-1.9-1.4-1.9-.8 0-1.3.5-1.5 1-.1.2-.1.5-.1.7V19h-3s.04-7.6 0-9h3v1.3c.4-.6 1.1-1.5 2.7-1.5 2 0 3.5 1.3 3.5 4V19z"/></svg>
            </a>
            <a href="https://x.com/LevelUp_edu" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
        <div class="text-center md:text-right text-[14px] text-[#dfdee2] space-y-2">
          <p class="font-medium tracking-[-0.02em]">Copyright © 2025 LevelUp Learning · All Rights Reserved</p>
          <p class="space-x-4 tracking-[-0.04em]">
            <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
            <a href="/terms" class="hover:text-white transition-colors">Terms Of Service</a>
          </p>
        </div>
      </div>
    </footer>

    <!-- Page interactions: scroll reveal, hero parallax, tilt, hover effects.
         Loaded as client:idle so it never blocks first paint. Safe for SEO —
         content stays visible by default; this only ADDS animation. -->
    <PageInteractions course="lokesh-kanagaraj" courseName="Lokesh Kanagaraj Masterclass" price={1499} client:idle />
  </main>
</BaseLayout>
