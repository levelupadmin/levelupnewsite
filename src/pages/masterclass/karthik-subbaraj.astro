<script>
  /* The film reel plays only while it is on screen, and never for reduced motion. */
  const reels = document.querySelectorAll<HTMLVideoElement>("[data-inview-video]");
  if (reels.length && "IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            v.muted = true;
            v.play()?.catch(() => {});
          } else v.pause();
        }
      },
      { threshold: 0.35 }
    );
    reels.forEach((v) => io.observe(v));
  }
</script>
