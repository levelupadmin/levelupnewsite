---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EpisodeAccordion from "@/components/lokesh/EpisodeAccordion";
import TestimonialCarousel from "@/components/lokesh/TestimonialCarousel";
import IntersectionPlayVideo from "@/components/lokesh/IntersectionPlayVideo";
import StickyMobileCta from "@/components/lokesh/StickyMobileCta.astro";
import PageInteractions from "@/components/lokesh/PageInteractions";
import { courseJsonLd, breadcrumbJsonLd, faqJsonLd } from "@/lib/structuredData";

const ASSET = "/masterclass/karthik";

const CTA_HREF = "https://app.leveluplearning.in/checkout/a12026ce-d878-4f00-9ffd-820511cdcd54";

const LOGO = `${ASSET}/a8eE1EildFXNeATLOwL1H78K0bc.png`;
const HERO_BG = `${ASSET}/sw7kIUP7AnyBvf57dO2F4Y96Ryo.jpg`;
const HERO_VIDEO = `${ASSET}/UCXfFQRLOPyAhT7UYvqMrrVttY.mp4`;
const TITLE_IMG = `${ASSET}/WQZTBlUPCA8Z0ZamKHnmURN7g.png`;
const STAGE_BG = `${ASSET}/1zj5LPCMiUBOgtwRrMIAhBS9cM8.png`;
const TRAILER_VIDEO = `${ASSET}/CdsBMjZPxHfcxZT01qMKgo9NeJ0.mp4`;
const TRAILER_POSTER = `${ASSET}/QoADD6MJ0hOF3uiMrmuSkEtPG4.png`;
const CLASSINFO_BG = `${ASSET}/l5morsJ1odtaOFccrOgLQslzs.png`;
const FILMSTRIP_BG = `${ASSET}/e9liRJamCSpmlzngSxt65LymFFw.png`;
const REEL = `${ASSET}/SsZ1glhQF4nnbsxeD5nq3qO5O8o.png`;
const RINGS = `${ASSET}/JNo817gaJtgUMYq7V8sUdzBHM.png`;
const WHO_PILLS = `${ASSET}/l8BvqqI8AQsZB54imLU7fogLRR0.png`;
const WHY_BG = `${ASSET}/Cc2kJRwz6AeaFjFQmylubnTv2E.png`;
const CUTOUT_L = `${ASSET}/IHEuFBe9iwHtVmPjoIxuDpx2x9Q.png`;
const CUTOUT_R = `${ASSET}/NTY3oU17X40h3eJmiunmYaM57Y.png`;
const CERT_BG = `${ASSET}/G0QgGhabjypHbqS4ywFcDMJCMw.png`;
const CERT_BANNER = `${ASSET}/CeEeSQZ6BSQTC2wrnrTbSN3GQU.png`;
const REVIEWS_BG = `${ASSET}/gy2I8jYLhOBOTXke3EkuIL75o.png`;
const GET_BG = `${ASSET}/9Ls6v83DqKarYkmLsjyRTpyJyik.png`;

// Curriculum lessons. Titles and descriptions are verbatim from the live
// Framer original (descriptions recovered from the expanded accordion).
const episodes = [
  { number: 1, title: "Discover the Roots of Filmmaking", description: "How did an award-winning filmmaker turn childhood passions into cinematic masterpieces? Learn how Karthik Subbaraj's creative journey shaped his unique approach to filmmaking—starting from writing poetry to directing his first short film." },
  { number: 2, title: "The Power of Stories", description: "Film has the power to shape cultures. Dive into the deep responsibility of storytelling and how to craft messages that audiences will connect with—and remember long after they leave the theater." },
  { number: 3, title: "Unearth Stories from Everyday Moments", description: "Ever wonder how filmmakers find their stories? Discover Karthik's process for capturing everyday experiences and turning them into cinematic gold." },
  { number: 4, title: "Research That Elevates Stories", description: "Great filmmakers know that research can transform a film. Explore how Karthik uses research to deepen his films and create believable, compelling worlds." },
  { number: 5, title: "Master the Art of Story Structure", description: "Learn how to shape your story, balancing creativity with practical constraints like time and budget, without losing narrative power." },
  { number: 6, title: "Crafting the Blueprint—Your Screenplay", description: "A great screenplay is the foundation of any film. Uncover how Karthik writes screenplays that serve as guides, not just for himself, but for his entire team." },
  { number: 7, title: "Inside Jigarthanda—Scene Breakdown", description: "Get an exclusive look into the creative process behind the scenes of Jigarthanda. Karthik reveals his inspirations and how he shaped key moments." },
  { number: 8, title: "Breathing Life into Characters", description: "Learn how to create multidimensional, unforgettable characters that drive your story and captivate audiences." },
  { number: 9, title: "The Journey of Sethu in Jigarthanda", description: "Explore the character arc of Sethu and discover the strategies behind crafting compelling, dynamic characters." },
  { number: 10, title: "Master Montages—Create Magic on Screen", description: "Discover how montages can enrich your film's storytelling. Learn from Jigarthanda's creative use of this technique." },
  { number: 11, title: "Crafting Powerful Dialogue", description: "Struggling with dialogue? Learn Karthik's tips for writing and revising lines that feel authentic and drive the narrative." },
  { number: 12, title: "Is Your Script Ready?", description: "Get the techniques for evaluating and improving your script, with insights into feedback and revisions." },
  { number: 13, title: "Planning Like a Pro—Pre-Production Essentials", description: "Master the often-overlooked art of pre-production. Learn how planning affects everything from filming to post-production and beyond." },
  { number: 14, title: "Cinematography—The Director's Eye", description: "Learn how to collaborate with cinematographers to turn your vision into a visual reality that tells a story through every shot." },
  { number: 15, title: "Pizza's Visual Storytelling", description: "See how Karthik planned shots in Pizza, and learn how every angle and movement was designed to engage audiences." },
  { number: 16, title: "Creating a Signature Visual Style", description: "Discover how Karthik develops his unique visual style with storyboards and shot divisions, ensuring consistency and artistic impact." },
  { number: 17, title: "Petta's Storyboard Masterclass", description: "Learn how storyboarding is essential for creating a coherent visual style, with an in-depth case study from Petta." },
  { number: 18, title: "The Art of Production Design", description: "Understand how art direction shapes the visual language of a film, working closely with the director and cinematographer." },
  { number: 19, title: "Building Petta's World—Behind the Scenes", description: "See how world-building made Petta's world immersive and believable, and how you can apply these techniques to your own films." },
  { number: 20, title: "Directing Actors to Excellence", description: "Learn how to direct actors to bring out the best performances and how casting decisions can transform your film." },
  { number: 21, title: "The Art of Editing—A Director's Best Friend", description: "Discover how editors can save a film, and how directors and editors work together to bring the best version of the story to life." },
  { number: 22, title: "Music & Sound—The Heartbeat of a Film", description: "Music and sound design can make or break a film. Learn Karthik's approach to scoring films and how sound adds depth to storytelling." },
  { number: 23, title: "Music's Role in Iraivi", description: "Get an insider's look at how Karthik used songs in Iraivi to move the story forward and evoke emotion." },
  { number: 24, title: "The Filmmaker's Journey", description: "Take a final lesson from Karthik as he shares the realities, challenges, and rewards of life as a filmmaker—and what it takes to succeed." },
];

// "What you'll get" 3D coverflow — four on-set stills fanned in a perspective stage.
const coverflow = {
  front: `${ASSET}/ClYKXiRyht3B49LiGvt1h3Ys8k4.png`,
  back: `${ASSET}/VtYabB70qe6NdtSJjJ5uSLlSN7s.png`,
  left: `${ASSET}/2S4HcsEFBSz3lg9dbf4Go3XkK4.png`,
  right: `${ASSET}/DI1OOeZ57xFz2law2yc0tSSV0a4.png`,
};

const audience = [
  "Dialogue Writers",
  "Screenplay Writers",
  "Filmmakers",
  "Film Enthusiasts",
  "Aspiring Directors",
  "Cinema Aspirants",
];

// Why-masterclass static fanned poster stack (3 cards, all visible — no cycle).
// Back-to-front paint order matches the original: the -12 card is at the back,
// the +4 card sits on top. Stacked concentrically via grid-area:1/1.
const whyCards = [
  { caption: "Understand the importance of storyboarding for a scene", image: `${ASSET}/cx8Cc19SgSO5w6TPi0kjSgcvp0.png`, rot: -12 },
  { caption: "Dive deeper into scene analysis with the Instructor's insightful case studies.", image: `${ASSET}/sF8gHjdHzP2c2QYYGykFUhPvxE.png`, rot: -4 },
  { caption: "Provides a fresh perspective on the art of filmmaking.", image: `${ASSET}/g1EH6zoC7bMvJv2iMIeJKmoocBM.png`, rot: 4 },
];

const testimonials = [
  { name: "Swetha", role: "Theatre Artist", quote: "Karthik's course is amazing. I want to be able to write a screenplay for film one day and this course has really helped me to get my feet wet in the world of screenwriting. What I like about this class so much is the combination of actionable steps and theory derived from the craft of story telling.", image: `${ASSET}/2de6WAVM1jKH5Jy1NACbiTZA7jE.webp` },
  { name: "Prem Kumar", role: "Actor", quote: "As an aspiring filmmaker with a burning passion for storytelling, taking Karthik's filmmaking class was an absolute game-changer for me. The course provided a comprehensive and practical guide, covering everything from crafting compelling storylines to the nitty-gritty of directing and editing.", image: `${ASSET}/Rj7zTcDJTxVKUd8onKeWL9jrM.png` },
  { name: "Gokulnath", role: "Director", quote: "Enrolling in Karthik's filmmaking course was a turning point in my artistic journey. The course caters to filmmakers of all levels, and I appreciated how Karthik emphasized the importance of creative expression throughout the process. If you have a love for filmmaking, this course is a must!", image: `${ASSET}/x6sjoC33XsZbirH06hqok8eVmCI.webp` },
];

const faqs = [
  { question: "Who is this class for?", answer: "This class is for aspiring filmmakers, screenwriters, dialogue writers, assistant directors, actors, and anyone who loves cinema and wants to understand how films are really made. No prior filmmaking experience is required." },
  { question: "I'm an Intermediate or Professional Filmmaker, would I benefit from this?", answer: "Yes. Karthik shares the actual craft and decision-making behind his films, scene breakdowns, visual style, casting, editing and sound, that experienced filmmakers rarely get to see explained first-hand." },
  { question: "What do I need to learn from this class?", answer: "You'll learn Karthik Subbaraj's complete approach to filmmaking: finding and structuring stories, writing screenplays and dialogue, pre-production planning, cinematography, production design, directing actors, editing, and music, with real case studies from his own films." },
  { question: "Will Karthik Subbaraj be teaching the Class?", answer: "Yes. Every lesson is taught directly by Karthik Subbaraj, using examples and stories from his own films." },
  { question: "Which Language is the course in?", answer: "The lessons are in simple Tamil with English subtitles. Dubbed versions in Hindi, Telugu, Kannada and Malayalam will be available soon." },
  { question: "Are there any recurring costs that I need to pay to access the videos?", answer: "No. You pay once, ₹2,499, and get lifetime access. No subscription, no renewals, no hidden charges." },
  { question: "How long is the Class?", answer: "25 video lessons, around 3 hours 20 minutes of content in total. Watch at your own pace and revisit any lesson any time." },
  { question: "When do I get to download the customised signed certificate?", answer: "Once you complete the course, you'll receive a personalised Certificate of Completion signed by Karthik Subbaraj, ready to download and share." },
  { question: "Where can I watch these classes?", answer: "On any device, laptop, tablet or phone, through the LevelUp Learning platform. Accessible 24/7 once you enroll." },
  { question: "Will I get a certificate for this masterclass?", answer: "Yes. A personalised Certificate of Completion signed by Karthik Subbaraj, downloadable as a PDF and shareable on social media or LinkedIn." },
];

const course = courseJsonLd({
  name: "Karthik Subbaraj Filmmaking Masterclass",
  description: "Exclusive online filmmaking masterclass with award-winning director Karthik Subbaraj (Jigarthanda, Petta, Pizza, Mahaan, Jagame Thandhiram). 25 lessons covering storytelling, screenplay, dialogue, cinematography, directing, editing and sound. Tamil with English subtitles. Signed Certificate. ₹2,499.",
  path: "/masterclass/karthik-subbaraj",
  instructorName: "Karthik Subbaraj",
  image: HERO_BG,
  courseMode: "online",
});
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Masterclasses", path: "/" },
  { name: "Karthik Subbaraj", path: "/masterclass/karthik-subbaraj" },
]);
const faq = faqJsonLd(faqs);
---

<BaseLayout
  title="Karthik Subbaraj Filmmaking Masterclass | LevelUp Learning"
  description="Learn filmmaking with award-winning director Karthik Subbaraj, behind Jigarthanda, Petta, Pizza, Mahaan and Jagame Thandhiram. 25 video lessons. Tamil with English subtitles. Signed Certificate. ₹2,499 lifetime access."
  path="/masterclass/karthik-subbaraj"
  type="course"
  ogImage={HERO_BG}
  preloadImage={HERO_BG}
  jsonLd={[course, breadcrumb, faq]}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link rel="preconnect" href="https://api.fontshare.com" slot="head" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin slot="head" />

  <style is:global>
    @import url("https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700,800&f[]=satoshi@400,500,700&display=swap");
    @import url("https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&family=DM+Serif+Text&display=swap");

    .karthik-page {
      --bg: #000;
      --bg-card: #120a08;
      background: var(--bg);
      color: white;
      font-family: "Switzer", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .karthik-page .font-switzer { font-family: "Switzer", sans-serif; }
    .karthik-page .font-rethink { font-family: "Rethink Sans", sans-serif; }
    .karthik-page .font-manrope { font-family: "Manrope", sans-serif; }
    .karthik-page .font-satoshi { font-family: "Satoshi", sans-serif; }
    .karthik-page .font-dmserif { font-family: "DM Serif Text", serif; }

    /* Heading gradients pulled from the Framer page. */
    .karthik-page .k-grad-1 { background: linear-gradient(90deg, #c4a723 0%, #bc3608 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .karthik-page .k-grad-2 { background: linear-gradient(0deg, #c4a723 0%, #8e0b05 105%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    /* Certificate "01/02/03" — solid gold at the baseline fading up to transparent. */
    .karthik-page .k-num { background: linear-gradient(0deg, #f9bc21 0%, rgba(249, 188, 33, 0) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

    /* Buy pill — the original is a SOLID #C32F08 (rgb 195,47,8) with a subtle
       white top-gloss overlay and ~10px radius. White label, Satoshi 700. */
    .karthik-page .buy-pill {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 100%), #c32f08;
      color: #fff;
      box-shadow: 0 14px 28px -12px rgba(195, 47, 8, 0.5);
      font-family: "Satoshi", sans-serif;
      font-weight: 700;
      border-radius: 10px;
      transition: filter 0.25s, transform 0.25s;
    }
    .karthik-page .buy-pill:hover { filter: brightness(1.07); transform: translateY(-1px); }

    /* Hero background video fades in over the static poster (original: spring appear, ~1.6s).
       Base opacity is 1 so the video is always visible if the animation never runs. */
    .karthik-page .hero-video { opacity: 1; animation: kHeroFade 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both; }
    @keyframes kHeroFade { from { opacity: 0; } to { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .karthik-page .hero-video { animation: none; opacity: 1; } }

    .karthik-page .star-bg { background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px), radial-gradient(rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 36px 36px, 88px 88px; }
    .karthik-page .reveal { opacity: 1; transform: none; transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
    html.mc-js-on .karthik-page .reveal { opacity: 0; transform: translateY(28px); }
    html.mc-js-on .karthik-page .reveal.mc-in { opacity: 1; transform: translateY(0); }
    /* Cert cards drop IN from above (original: card 1 from -160px, cards 2-3 from
       -80px, with a subtle spring/bounce). Per-card distance via --drop. */
    html.mc-js-on .karthik-page .reveal.reveal-drop { transform: translateY(var(--drop, -80px)); transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.34, 1.3, 0.55, 1); }
    html.mc-js-on .karthik-page .reveal.reveal-drop.mc-in { transform: translateY(0); }
    /* Coverflow ("what you'll get") appear: fade only — no translate — so the
       preserve-3d card transforms are never overwritten (original: opacity 0.001 -> 1). */
    html.mc-js-on .karthik-page .reveal.reveal-fade,
    html.mc-js-on .karthik-page .reveal.reveal-fade.mc-in { transform: none; }
    @media (prefers-reduced-motion: reduce) { html.mc-js-on .karthik-page .reveal { opacity: 1 !important; transform: none !important; } }
    .karthik-page .lift { transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease; will-change: transform; }
    .karthik-page .lift:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.55), 0 8px 24px -8px rgba(0, 0, 0, 0.7); border-color: rgba(117, 75, 12, 0.5); }
    .karthik-page .tilt { transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }

    /* Native-details FAQ chevron. */
    .karthik-page .k-faq summary { list-style: none; }
    .karthik-page .k-faq summary::-webkit-details-marker { display: none; }
    .karthik-page .k-faq .k-faq-icon { transition: transform 0.3s ease; }
    .karthik-page .k-faq details[open] .k-faq-icon { transform: rotate(45deg); }

    /* Role pills for the "who is this for" orbit. */
    .karthik-page .role-pill {
      background: linear-gradient(180deg, #2a0d06 0%, #160604 100%);
      border: 1px solid rgba(117, 75, 12, 0.6);
      box-shadow: inset 0 1px 0 rgba(255, 220, 150, 0.12);
    }

    /* Curriculum: internally scrolling list with a thin warm scrollbar. */
    .karthik-page .k-curriculum { scrollbar-width: thin; scrollbar-color: rgba(195, 47, 8, 0.5) transparent; }
    .karthik-page .k-curriculum::-webkit-scrollbar { width: 6px; }
    .karthik-page .k-curriculum::-webkit-scrollbar-thumb { background: rgba(195, 47, 8, 0.45); border-radius: 999px; }
    .karthik-page .k-curriculum::-webkit-scrollbar-track { background: transparent; }

    /* "Why is this masterclass" — static fanned photo-stack: 3 concentric
       poster cards, all visible, tilted +4 / -4 / -12. No animation in the
       original; the +4 card sits on top. */
    .karthik-page .why-card { grid-area: 1 / 1; }

    /* "What you'll get" 3D coverflow cards (perspective lives on the parent stage). */
    .karthik-page .cf-card {
      position: absolute; left: 50%; top: 50%;
      width: 214px; height: 284px; margin-left: -107px; margin-top: -142px;
      object-fit: cover; border-radius: 6px;
      outline: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 24px 60px -22px rgba(0, 0, 0, 0.85);
      backface-visibility: hidden;
    }

    html { scroll-behavior: smooth; }
  </style>

  <main id="main-content" class="karthik-page">
    <StickyMobileCta href={CTA_HREF} price={2499} course="karthik-subbaraj" />

    {/* ===================== HERO ===================== */}
    <section class="relative min-h-[92vh] md:min-h-screen overflow-hidden flex flex-col">
      <div class="absolute inset-0">
        <img src={HERO_BG} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover object-right md:object-center" />
        <video
          src={HERO_VIDEO}
          poster={HERO_BG}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          class="hero-video absolute inset-0 w-full h-full object-cover object-right md:object-center"
        ></video>
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/85 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/60"></div>
      </div>

      <header class="relative z-30 pt-5 md:pt-7">
        <div class="max-w-[1320px] mx-auto px-5 md:px-12 flex items-center">
          <a href="/" aria-label="LevelUp Learning home">
            <img src={LOGO} alt="LevelUp" class="h-10 md:h-[52px] w-auto" />
          </a>
        </div>
      </header>

      <div class="relative z-10 flex-1 flex items-center">
        <div class="max-w-[1320px] mx-auto px-5 md:px-12 w-full">
          <div class="max-w-[640px] py-12 md:py-0">
            <p class="font-manrope text-[15px] md:text-[18px] uppercase text-white font-bold leading-[1.2]">Learn Filmmaking With</p>
            <img src={TITLE_IMG} alt="Karthik Subbaraj" class="mt-4 md:mt-5 w-[280px] md:w-[440px] lg:w-[500px] h-auto" />
            <p class="font-manrope mt-5 md:mt-6 text-[16px] md:text-[18px] leading-[1.25] text-white max-w-[540px]">
              Join award-winning filmmaker Karthik Subbaraj in this exclusive class to master storytelling, editing and direction.
            </p>
            <div class="mt-7 md:mt-8">
              <a href={CTA_HREF} target="_blank" rel="noopener noreferrer" data-mc-hero-cta="true" class="buy-pill inline-flex items-center justify-center leading-none px-6 py-3 text-[15px] md:text-[18px] lg:text-[20px]">
                Buy now at ₹2,499
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ===================== STAGE BAND (decorative) ===================== */}
    <section class="relative overflow-hidden bg-black">
      <img src={STAGE_BG} alt="" aria-hidden="true" class="block w-full h-auto select-none pointer-events-none" loading="lazy" />
    </section>

    {/* ===================== CLASS INFO + CURRICULUM ===================== */}
    <section class="relative px-5 md:px-12 py-16 md:py-24" style={`background-image:url('${CLASSINFO_BG}'); background-size:cover; background-position:center;`}>
      <div class="absolute inset-0 bg-[#070707]/70"></div>
      <div class="relative max-w-[1200px] mx-auto">
        <div class="mb-10 md:mb-14">
          <h2 class="font-switzer k-grad-1 text-[40px] md:text-[52px] lg:text-[58px] leading-[1] tracking-[-0.03em] font-bold">Class Info</h2>
          <p class="font-manrope mt-3 text-[16px] md:text-[18px] text-white/55 font-medium">25 video lessons (3h 20m)</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-6 md:gap-8">
          <aside class="rounded-2xl border border-[#754B0C]/55 bg-[#120a08] p-7 md:p-8 h-fit lg:sticky lg:top-6">
            <p class="font-manrope text-[20px] font-medium text-white leading-[1.5] tracking-[0.4px]">Start your journey with Outstanding excellence</p>
            <p class="font-manrope mt-3 text-[16px] md:text-[18px] text-white/55 leading-[1.5]">(No complex theories- No prior filmmaking experience required- Just practical, actionable lessons)</p>

            <ul class="mt-7 space-y-4 font-manrope text-[16px] md:text-[18px] text-white/90">
              <li class="flex items-center gap-3">
                <svg class="w-6 h-6 shrink-0 text-[#FED604]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 2v4.586l7 7L14.586 9l-7-7zM2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586z"/><path d="M5.5 5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m0 1a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3M1 7.086a1 1 0 0 0 .293.707L8.75 15.25l-.043.043a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 0 7.586V3a1 1 0 0 1 1-1z"/></svg>
                <span>₹2,499</span>
              </li>
              <li class="flex items-center gap-3">
