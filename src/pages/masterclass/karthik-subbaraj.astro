---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EpisodeAccordion from "@/components/lokesh/EpisodeAccordion";
import TestimonialCarousel from "@/components/lokesh/TestimonialCarousel";
import HeroPlayer from "@/components/lokesh/HeroPlayer";
import IntersectionPlayVideo from "@/components/lokesh/IntersectionPlayVideo";
import StickyMobileCta from "@/components/lokesh/StickyMobileCta.astro";
import CountdownTimer from "@/components/lokesh/CountdownTimer";
import PageInteractions from "@/components/lokesh/PageInteractions";
import { courseJsonLd, breadcrumbJsonLd, faqJsonLd } from "@/lib/structuredData";

const ASSET = "/masterclass/karthik";

const CTA_HREF = "https://study.leveluplearning.in/web/checkout/63579ff53b15755299fbe082";

const LOGO = `${ASSET}/a8eE1EildFXNeATLOwL1H78K0bc.png`;
const HERO_BG = `${ASSET}/sw7kIUP7AnyBvf57dO2F4Y96Ryo.jpg`;
const HERO_VIDEO = `${ASSET}/UCXfFQRLOPyAhT7UYvqMrrVttY.mp4`;
const TITLE_IMG = `${ASSET}/WQZTBlUPCA8Z0ZamKHnmURN7g.png`;
const STAGE_BG = `${ASSET}/1zj5LPCMiUBOgtwRrMIAhBS9cM8.png`;
const TRAILER_VIDEO = `${ASSET}/CdsBMjZPxHfcxZT01qMKgo9NeJ0.mp4`;
const TRAILER_POSTER = `${ASSET}/QoADD6MJ0hOF3uiMrmuSkEtPG4.png`;
const CLASSINFO_BG = `${ASSET}/l5morsJ1odtaOFccrOgLQslzs.png`;
const FILMSTRIP_BG = `${ASSET}/e9liRJamCSpmlzngSxt65LymFFw.png`;
const REEL = `${ASSET}/SsZ1glhQF4nnbsxeD5nq3qO5O8o.png`;
const RINGS = `${ASSET}/JNo817gaJtgUMYq7V8sUdzBHM.png`;
const WHO_PILLS = `${ASSET}/l8BvqqI8AQsZB54imLU7fogLRR0.png`;
const WHY_BG = `${ASSET}/Cc2kJRwz6AeaFjFQmylubnTv2E.png`;
const CUTOUT_L = `${ASSET}/IHEuFBe9iwHtVmPjoIxuDpx2x9Q.png`;
const CUTOUT_R = `${ASSET}/NTY3oU17X40h3eJmiunmYaM57Y.png`;
const CERT_BG = `${ASSET}/G0QgGhabjypHbqS4ywFcDMJCMw.png`;
const CERT_BANNER = `${ASSET}/CeEeSQZ6BSQTC2wrnrTbSN3GQU.png`;
const REVIEWS_BG = `${ASSET}/gy2I8jYLhOBOTXke3EkuIL75o.png`;
const GET_BG = `${ASSET}/9Ls6v83DqKarYkmLsjyRTpyJyik.png`;
const GET_CENTER = `${ASSET}/DI1OOeZ57xFz2law2yc0tSSV0a4.png`;

// Class Info pricing-card icon list (3 Framer SVGs).
const ICON_TIME = `${ASSET}/6tTbkXggWgQCAJ4DO2QEdXXmgM.svg`;
const ICON_CERT = `${ASSET}/gAhDpBunUQjatqZJOiupEGvA2I.svg`;
const ICON_COMMUNITY = `${ASSET}/DT7ew3gD1V7s2jqnBQZM7wEf8.svg`;

// 25-lesson curriculum. Module 1 description is the verbatim Framer copy;
// the rest are written from the captured Framer titles.
const episodes = [
  { number: 1, title: "Discover the Roots of Filmmaking", description: "How did an award-winning filmmaker turn childhood passions into cinematic masterpieces? Learn how Karthik Subbaraj's creative journey shaped his unique approach to filmmaking, starting from writing poetry to directing his first short film." },
  { number: 2, title: "The Power of Stories", description: "Why stories move us, and how to harness that power as the foundation of every film you make." },
  { number: 3, title: "Unearth Stories from Everyday Moments", description: "Train your eye to spot compelling stories hidden in ordinary, everyday life." },
  { number: 4, title: "Research That Elevates Stories", description: "The research process that turns a thin idea into a rich, believable world." },
  { number: 5, title: "Master the Art of Story Structure", description: "Build a strong narrative spine using the structural principles behind memorable films." },
  { number: 6, title: "Crafting the Blueprint: Your Screenplay", description: "Turn your story into a working screenplay, the blueprint every film is built on." },
  { number: 7, title: "Inside Jigarthanda: Scene Breakdown", description: "A scene-by-scene breakdown of Jigarthanda, dissecting the choices that make it work." },
  { number: 8, title: "Breathing Life into Characters", description: "Create characters with depth, contradiction, and a real reason to exist on screen." },
  { number: 9, title: "The Journey of Sethu in Jigarthanda", description: "Follow one character's arc to understand how transformation drives a story." },
  { number: 10, title: "Master Montages: Create Magic on Screen", description: "Use montage to compress time, build emotion, and create cinematic magic." },
  { number: 11, title: "Crafting Powerful Dialogue", description: "Write dialogue that reveals character, drives the scene, and sounds effortless." },
  { number: 12, title: "Is Your Script Ready?", description: "A practical checklist to pressure-test your script before you step on set." },
  { number: 13, title: "Planning Like a Pro: Pre-Production Essentials", description: "The pre-production planning that makes the shoot smooth and the film better." },
  { number: 14, title: "Cinematography: The Director's Eye", description: "See like a director: framing, movement, and the visual intent behind every shot." },
  { number: 15, title: "Pizza's Visual Storytelling", description: "How Pizza tells its story through visuals, atmosphere, and restraint." },
  { number: 16, title: "Creating a Signature Visual Style", description: "Develop a visual language that makes your work unmistakably yours." },
  { number: 17, title: "Petta's Storyboard Masterclass", description: "Inside the storyboards of Petta, planning spectacle shot by shot." },
  { number: 18, title: "The Art of Production Design", description: "How production design builds the world your characters live in." },
  { number: 19, title: "Building Petta's World: Behind the Scenes", description: "A behind-the-scenes look at constructing the world of Petta." },
  { number: 20, title: "Directing Actors to Excellence", description: "Direct performances that feel true, from casting to the final take." },
  { number: 21, title: "The Art of Editing: A Director's Best Friend", description: "Why editing is where a film is truly written, and how to think like an editor." },
  { number: 22, title: "Music & Sound: The Heartbeat of a Film", description: "Use music and sound design to give your film its emotional pulse." },
  { number: 23, title: "Music's Role in Iraivi", description: "How music shapes meaning and emotion in Iraivi." },
  { number: 24, title: "The Filmmaker's Journey", description: "Closing the loop: turning everything you've learned into your own filmmaking journey." },
];

// "Behind these blockbuster films" band: orange-duotone on-set stills of Karthik directing.
const directorStills = [
  `${ASSET}/2S4HcsEFBSz3lg9dbf4Go3XkK4.png`,
  `${ASSET}/VtYabB70qe6NdtSJjJ5uSLlSN7s.png`,
  `${ASSET}/ClYKXiRyht3B49LiGvt1h3Ys8k4.png`,
];

const audience = [
  "Dialogue Writers",
  "Screenplay Writers",
  "Filmmakers",
  "Film Enthusiasts",
  "Aspiring Directors",
  "Cinema Aspirants",
];

const whyCards = [
  { caption: "Provides a fresh perspective on the art of filmmaking.", image: `${ASSET}/g1EH6zoC7bMvJv2iMIeJKmoocBM.png` },
  { caption: "Dive deeper into scene analysis with the Instructor's insightful case studies.", image: `${ASSET}/sF8gHjdHzP2c2QYYGykFUhPvxE.png` },
  { caption: "Understand the importance of storyboarding for a scene.", image: `${ASSET}/cx8Cc19SgSO5w6TPi0kjSgcvp0.png` },
];

const testimonials = [
  { name: "Swetha", role: "Theatre Artist", quote: "Karthik's course is amazing. I want to be able to write a screenplay for film one day and this course has really helped me to get my feet wet in the world of screenwriting. What I like about this class so much is the combination of actionable steps and theory derived from the craft of story telling.", image: `${ASSET}/2de6WAVM1jKH5Jy1NACbiTZA7jE.webp` },
  { name: "Prem Kumar", role: "Actor", quote: "As an aspiring filmmaker with a burning passion for storytelling, taking Karthik's filmmaking class was an absolute game-changer for me. The course provided a comprehensive and practical guide, covering everything from crafting compelling storylines to the nitty-gritty of directing and editing.", image: `${ASSET}/Rj7zTcDJTxVKUd8onKeWL9jrM.png` },
  { name: "Gokulnath", role: "Director", quote: "Enrolling in Karthik's filmmaking course was a turning point in my artistic journey. The course caters to filmmakers of all levels, and I appreciated how Karthik emphasized the importance of creative expression throughout the process. If you have a love for filmmaking, this course is a must!", image: `${ASSET}/x6sjoC33XsZbirH06hqok8eVmCI.webp` },
];

const whatYouGet = [
  { title: "Opportunity to learn from the best", description: "Direct, hands-on insight from Karthik Subbaraj himself." },
  { title: "Case Studies and Examples", description: "Real breakdowns from Jigarthanda, Petta, Pizza and more." },
  { title: "Detailed Insights into the creative process", description: "How ideas become scenes, and scenes become films." },
  { title: "Film Management", description: "Run a production from pre to post like a professional." },
  { title: "Planning and Supporting Functions", description: "The planning and support systems behind every shoot." },
  { title: "Secrets and personal experiences", description: "Lessons and stories from a career of award-winning cinema." },
];
const getLeft = whatYouGet.slice(0, 3);
const getRight = whatYouGet.slice(3);

const faqs = [
  { question: "Who is this class for?", answer: "This class is for aspiring filmmakers, screenwriters, dialogue writers, assistant directors, actors, and anyone who loves cinema and wants to understand how films are really made. No prior filmmaking experience is required." },
  { question: "I'm an Intermediate or Professional Filmmaker, would I benefit from this?", answer: "Yes. Karthik shares the actual craft and decision-making behind his films, scene breakdowns, visual style, casting, editing and sound, that experienced filmmakers rarely get to see explained first-hand." },
  { question: "What do I need to learn from this class?", answer: "You'll learn Karthik Subbaraj's complete approach to filmmaking: finding and structuring stories, writing screenplays and dialogue, pre-production planning, cinematography, production design, directing actors, editing, and music, with real case studies from his own films." },
  { question: "Will Karthik Subbaraj be teaching the Class?", answer: "Yes. Every lesson is taught directly by Karthik Subbaraj, using examples and stories from his own films." },
  { question: "Which Language is the course in?", answer: "The lessons are in simple Tamil with English subtitles. Dubbed versions in Hindi, Telugu, Kannada and Malayalam will be available soon." },
  { question: "Are there any recurring costs that I need to pay to access the videos?", answer: "No. You pay once, ₹2,499, and get lifetime access. No subscription, no renewals, no hidden charges." },
  { question: "How long is the Class?", answer: "25 video lessons, around 3 hours 20 minutes of content in total. Watch at your own pace and revisit any lesson any time." },
  { question: "When do I get to download the customised signed certificate?", answer: "Once you complete the course, you'll receive a personalised Certificate of Completion signed by Karthik Subbaraj, ready to download and share." },
  { question: "Where can I watch these classes?", answer: "On any device, laptop, tablet or phone, through the LevelUp Learning platform. Accessible 24/7 once you enroll." },
  { question: "Will I get a certificate for this masterclass?", answer: "Yes. A personalised Certificate of Completion signed by Karthik Subbaraj, downloadable as a PDF and shareable on social media or LinkedIn." },
];

const course = courseJsonLd({
  name: "Karthik Subbaraj Filmmaking Masterclass",
  description: "Exclusive online filmmaking masterclass with award-winning director Karthik Subbaraj (Jigarthanda, Petta, Pizza, Mahaan, Jagame Thandhiram). 25 lessons covering storytelling, screenplay, dialogue, cinematography, directing, editing and sound. Tamil with English subtitles. Signed Certificate. ₹2,499.",
  path: "/masterclass/karthik-subbaraj",
  instructorName: "Karthik Subbaraj",
  image: HERO_BG,
  courseMode: "online",
});
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Masterclasses", path: "/" },
  { name: "Karthik Subbaraj", path: "/masterclass/karthik-subbaraj" },
]);
const faq = faqJsonLd(faqs);
---

<BaseLayout
  title="Karthik Subbaraj Filmmaking Masterclass | LevelUp Learning"
  description="Learn filmmaking with award-winning director Karthik Subbaraj, behind Jigarthanda, Petta, Pizza, Mahaan and Jagame Thandhiram. 25 video lessons. Tamil with English subtitles. Signed Certificate. ₹2,499 lifetime access."
  path="/masterclass/karthik-subbaraj"
  type="course"
  ogImage={HERO_BG}
  preloadImage={HERO_BG}
  jsonLd={[course, breadcrumb, faq]}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link rel="preconnect" href="https://api.fontshare.com" slot="head" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin slot="head" />

  <style is:global>
    @import url("https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700,800&display=swap");
    @import url("https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700;800&display=swap");

    .karthik-page {
      --bg: #070707;
      --bg-card: #120a08;
      background: var(--bg);
      color: white;
      font-family: "Switzer", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .karthik-page .font-switzer { font-family: "Switzer", sans-serif; }
    .karthik-page .font-rethink { font-family: "Rethink Sans", sans-serif; }

    /* Heading gradients pulled from the Framer page. */
    .karthik-page .k-grad-1 { background: linear-gradient(90deg, #c4a723 0%, #bc3608 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .karthik-page .k-grad-2 { background: linear-gradient(0deg, #c4a723 0%, #8e0b05 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .karthik-page .k-grad-3 { background: linear-gradient(90deg, #bc3608 0%, #e9b53a 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .karthik-page .text-gold-k { background: linear-gradient(180deg, #f3d77a 0%, #d9a93c 50%, #9c6b1e 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

    /* Red-orange buy pill (Karthik uses warm fire tones, not Lokesh/Ravi gold). */
    .karthik-page .buy-pill {
      background: linear-gradient(180deg, #ff7a3c 0%, #f1571a 45%, #d23a08 100%);
      color: #fff;
      box-shadow: 0 14px 28px -10px rgba(241, 87, 26, 0.55), inset 0 1px 0 rgba(255, 200, 160, 0.55);
      font-weight: 700;
      transition: filter 0.25s, transform 0.25s;
    }
    .karthik-page .buy-pill:hover { filter: brightness(1.07); transform: translateY(-1px); }

    .karthik-page .star-bg { background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px), radial-gradient(rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 36px 36px, 88px 88px; }
    .karthik-page .reveal { opacity: 1; transform: none; transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
    html.mc-js-on .karthik-page .reveal { opacity: 0; transform: translateY(28px); }
    html.mc-js-on .karthik-page .reveal.mc-in { opacity: 1; transform: translateY(0); }
    @media (prefers-reduced-motion: reduce) { html.mc-js-on .karthik-page .reveal { opacity: 1 !important; transform: none !important; } }
    .karthik-page .lift { transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease; will-change: transform; }
    .karthik-page .lift:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -16px rgba(241, 87, 26, 0.28), 0 8px 24px -8px rgba(0, 0, 0, 0.7); border-color: rgba(241, 87, 26, 0.3); }
    .karthik-page .tilt { transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
    .karthik-page .section-tick { display: inline-block; width: 1px; height: 24px; background: linear-gradient(180deg, transparent, #e9663a, transparent); margin: 0 auto; }

    /* Native-details FAQ chevron. */
    .karthik-page .k-faq summary { list-style: none; }
    .karthik-page .k-faq summary::-webkit-details-marker { display: none; }
    .karthik-page .k-faq .k-faq-icon { transition: transform 0.3s ease; }
    .karthik-page .k-faq details[open] .k-faq-icon { transform: rotate(45deg); }

    /* Role pills for the "who is this for" orbit. */
    .karthik-page .role-pill {
      background: linear-gradient(180deg, #2a0d06 0%, #160604 100%);
      border: 1px solid rgba(241, 102, 58, 0.45);
      box-shadow: 0 0 22px -4px rgba(241, 102, 58, 0.5), inset 0 1px 0 rgba(255, 160, 110, 0.15);
    }

    html { scroll-behavior: smooth; }
  </style>

  <main id="main-content" class="karthik-page">
    <StickyMobileCta href={CTA_HREF} price={2499} course="karthik-subbaraj" />

    {/* ===================== HERO ===================== */}
    <section class="relative min-h-[92vh] md:min-h-screen overflow-hidden flex flex-col">
      <div class="absolute inset-0">
        <img src={HERO_BG} alt="" aria-hidden="true" class="w-full h-full object-cover object-right md:object-center" />
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/85 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/60"></div>
      </div>

      <header class="relative z-30 px-5 md:px-12 pt-5 md:pt-7 flex items-center justify-between gap-4">
        <a href="/" aria-label="LevelUp Learning home" class="md:absolute md:left-1/2 md:-translate-x-1/2">
          <img src={LOGO} alt="LevelUp" class="h-8 md:h-9 w-auto" />
        </a>
        <a href={CTA_HREF} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex buy-pill ml-auto px-5 py-2.5 rounded-full text-[13px]">Buy now at ₹2,499</a>
      </header>

      <div class="relative z-10 flex-1 flex items-center">
        <div class="max-w-[1320px] mx-auto px-5 md:px-12 w-full">
          <div class="max-w-[640px] py-12 md:py-0">
            <p class="font-switzer text-[12px] md:text-[14px] tracking-[0.34em] uppercase text-white/70 font-semibold">Learn Filmmaking With</p>
            <img src={TITLE_IMG} alt="Karthik Subbaraj" class="mt-4 md:mt-5 w-[280px] md:w-[440px] lg:w-[500px] h-auto" />
            <p class="mt-5 md:mt-7 text-[16px] md:text-[19px] lg:text-[21px] leading-[1.5] text-white/85 max-w-[560px] font-medium">
              Join award-winning filmmaker Karthik Subbaraj in this exclusive class to master storytelling, editing and direction.
            </p>
            <div class="mt-7 md:mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
              <a href={CTA_HREF} target="_blank" rel="noopener noreferrer" data-mc-hero-cta="true" class="buy-pill inline-flex items-center justify-center px-8 py-3.5 rounded-full text-[15px] md:text-[16px]">
                Buy now at ₹2,499
              </a>
              <p class="text-[13px] text-white/70">
                <span class="text-amber-300/95 align-middle mr-1.5" aria-hidden="true">★★★★★</span>
                <span class="align-middle">One-time payment · Lifetime access</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ===================== TRAILER (theatre stage) ===================== */}
    <section class="relative overflow-hidden">
      <div class="relative w-full" style={`background-image:url('${STAGE_BG}'); background-size:cover; background-position:center;`}>
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="relative max-w-[1100px] mx-auto px-6 md:px-12 py-[10vw] md:py-[7vw]">
          <div class="relative mx-auto max-w-[760px] rounded-[10px] overflow-hidden ring-1 ring-[#f1571a]/45 shadow-[0_30px_90px_-20px_rgba(0,0,0,0.85)]">
            <div class="relative aspect-video bg-black">
              <HeroPlayer src={TRAILER_VIDEO} poster={TRAILER_POSTER} ariaLabel="Play Karthik Subbaraj masterclass trailer" client:load />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ===================== CLASS INFO + CURRICULUM ===================== */}
    <section class="relative px-5 md:px-12 py-16 md:py-24" style={`background-image:url('${CLASSINFO_BG}'); background-size:cover; background-position:center;`}>
      <div class="absolute inset-0 bg-[#070707]/70"></div>
      <div class="relative max-w-[1180px] mx-auto">
        <div class="text-center mb-10 md:mb-14 reveal">
          <h2 class="font-switzer k-grad-1 text-[40px] md:text-[52px] lg:text-[58px] leading-[1] tracking-[-0.02em] font-bold">Class Info</h2>
          <p class="mt-3 text-[13px] md:text-[15px] tracking-[0.28em] uppercase text-white/60">25 video lessons · 3h 20m</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-6 md:gap-8">
          <aside class="rounded-2xl border border-[#f1571a]/20 bg-[#120a08] p-7 md:p-8 h-fit lg:sticky lg:top-6">
            <p class="font-rethink text-[20px] md:text-[23px] font-bold text-white leading-[1.2] tracking-[-0.02em]">Start your journey with <span class="k-grad-3">Outstanding excellence</span></p>
            <p class="mt-3 text-[13px] md:text-[14px] text-white/55 leading-[1.55]">No complex theories. No prior filmmaking experience required. Just practical, actionable lessons.</p>

            <ul class="mt-6 space-y-4 text-[14px] md:text-[15px] text-white/90">
              <li class="flex items-center gap-3"><img src={ICON_TIME} alt="" aria-hidden="true" class="w-6 h-6 shrink-0" /><span>4 hours of video content</span></li>
              <li class="flex items-center gap-3"><img src={ICON_CERT} alt="" aria-hidden="true" class="w-6 h-6 shrink-0" /><span>Certificate of completion</span></li>
              <li class="flex items-center gap-3"><img src={ICON_COMMUNITY} alt="" aria-hidden="true" class="w-6 h-6 shrink-0" /><span>Free access to Cine Circle community</span></li>
            </ul>

            <div class="mt-6 flex items-baseline gap-3">
              <span class="font-rethink text-[44px] md:text-[52px] font-extrabold text-white tracking-[-0.04em] leading-none">₹2,499</span>
              <span class="text-[14px] text-white/45">one-time</span>
            </div>
            <a href={CTA_HREF} target="_blank" rel="noopener noreferrer" class="buy-pill mt-5 inline-flex w-full items-center justify-center px-5 py-3.5 rounded-full text-[15px]">
              Buy now at ₹2,499
            </a>
            <div class="mt-4 flex justify-center">
              <CountdownTimer storageKey="karthik-countdown-v1" tone="alert" client:load />
            </div>
            <p class="mt-3 text-center text-[12px] text-white/50">One-time payment. No subscription, no renewal.</p>
          </aside>

          <div><EpisodeAccordion episodes={episodes} initialVisible={6} client:visible /></div>
        </div>
      </div>
    </section>

    {/* ===================== BLOCKBUSTER FILMS ===================== */}
    <section class="relative py-16 md:py-24 overflow-hidden" style={`background-image:url('${FILMSTRIP_BG}'); background-size:cover; background-position:center;`}>
      <div class="absolute inset-0 bg-[#070707]/55"></div>
      <div class="relative max-w-[1280px] mx-auto px-5 md:px-12">
        <h2 class="font-switzer text-[30px] md:text-[44px] lg:text-[56px] leading-[1.08] tracking-[-0.03em] font-bold max-w-[820px] reveal">
          <span class="k-grad-2">Learn from the Director</span><br /><span class="text-white">Behind these Blockbuster Films</span>
        </h2>
        <p class="mt-5 text-[15px] md:text-[18px] leading-[1.55] text-white/70 max-w-[640px] reveal">Pizza. Jigarthanda. Iraivi. Petta. Years of award-winning, genre-bending cinema, distilled into one masterclass.</p>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
          {directorStills.map((src) => (
            <figure class="lift rounded-xl overflow-hidden ring-1 ring-[#f1571a]/20 bg-black aspect-[4/3]">
