---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Index from "@/pages-react/Index.tsx";

const title = "LevelUp Learning — Online Filmmaking & Creative Courses India";
const description =
  "Learn filmmaking, screenwriting & editing from India's top directors. Masterclasses by Lokesh Kanagaraj & Nelson. Join 18,000+ creators.";
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  preloadImage="/images/hero-poster-1.jpg"
>
  <Index client:idle />
</BaseLayout>
