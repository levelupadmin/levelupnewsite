---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StudentStory from "@/pages-react/StudentStory.tsx";
import { studentStories } from "@/data/studentStories";
import { articleJsonLd, breadcrumbJsonLd } from "@/lib/structuredData";
import { migratedLegacySlugs } from "@/lib/storyMigration.mjs";

export async function getStaticPaths() {
  // A story that has moved to /blog 301s from here instead of rendering, or the
  // same words would sit on two of our own URLs. Duplicating ourselves across
  // the domain is part of what this work exists to undo.
  const migrated = migratedLegacySlugs();

  return studentStories
    .filter((story) => !migrated.has(story.slug))
    .map((story) => ({
      params: { slug: story.slug },
      props: { story },
    }));
}

const { story } = Astro.props;

const article = articleJsonLd({
  title: story.h1,
  description: story.metaDescription,
  path: `/student-stories/${story.slug}`,
  authorName: story.authorName,
  datePublished: "2026-03-01",
});

const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Student Stories", path: "/student-stories" },
  { name: story.h1, path: `/student-stories/${story.slug}` },
]);
---

<BaseLayout
  title={story.seoTitle}
  description={story.metaDescription}
  path={`/student-stories/${story.slug}`}
  ogImage="/og/student-stories.jpg"
  type="article"
  jsonLd={[article, breadcrumb]}
>
  <StudentStory slug={story.slug} client:idle />
</BaseLayout>
