---
import BlogLayout from "@/layouts/BlogLayout.astro";
import Breadcrumbs from "@/components/blog/Breadcrumbs.astro";
import CategoryChips from "@/components/blog/CategoryChips.astro";
import PostCard from "@/components/blog/PostCard.astro";
import {
  CATEGORIES,
  decisionFor,
  getPosts,
  getPostsIn,
  postPath,
  type Category,
  type CategorySlug,
} from "@/lib/blog";
import { breadcrumbJsonLd } from "@/lib/structuredData";
import { SITE_URL } from "@/lib/constants";

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: Category };

const posts = await getPostsIn(category.slug);
const decision = await decisionFor(category.slug);
const all = await getPosts();

const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c.slug, all.filter((p) => p.data.category === c.slug).length]),
) as Record<CategorySlug, number>;

const path = `/blog/category/${category.slug}`;
const title = `${category.label} | LevelUp Learning Blog`;

const jsonLd = [
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
    { name: category.label, path },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description: category.standfirst,
    url: `${SITE_URL}${path}`,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: posts.length,
      itemListElement: posts.map((post, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: post.data.title,
        url: `${SITE_URL}${postPath(post)}`,
      })),
    },
  },
];
---

<BlogLayout title={title} description={category.standfirst} path={path} jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-border/40">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-80 opacity-[0.16]"
      style="background: radial-gradient(60% 100% at 50% 100%, hsl(var(--primary)), transparent 70%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-6 pb-14 pt-28 md:px-10 md:pb-16 md:pt-36">
      <Breadcrumbs
        items={[
          { name: "Home", path: "/" },
          { name: "Blog", path: "/blog" },
          { name: category.label, path },
        ]}
      />

      <h1 class="mt-8 max-w-3xl text-balance text-[2.5rem] font-semibold leading-[1.06] tracking-[-0.03em] text-foreground sm:text-[3.25rem] md:text-[4rem]">
        {category.label}
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-foreground/55 md:text-lg">
        {category.standfirst}
      </p>

      {/* The decision page is what most people arriving here are looking for,
          so it gets a link of its own rather than a place in the grid. */}
      {
        decision && (
          <a
            href={postPath(decision)}
            class="group mt-10 block max-w-2xl rounded-2xl border border-primary/30 bg-primary/[0.06] p-6 transition-colors hover:border-primary/60 md:p-7"
          >
            <p class="text-[0.6875rem] uppercase tracking-[0.2em] text-primary/80">
              Start here
            </p>
            <p class="mt-3 text-xl font-semibold leading-snug tracking-[-0.02em] text-foreground">
              {decision.data.title}
            </p>
            <p class="mt-2 text-sm leading-relaxed text-foreground/55">
              {decision.data.description}
            </p>
          </a>
        )
      }
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-6 py-14 md:px-10 md:py-20">
    <CategoryChips active={category.slug} counts={counts} total={all.length} />

    {
      posts.length > 0 ? (
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-foreground/50">
          Nothing published in {category.label.toLowerCase()} yet.
        </p>
      )
    }
  </div>
</BlogLayout>
