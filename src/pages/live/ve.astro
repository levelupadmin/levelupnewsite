---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LiveVE from "@/pages-react/LiveVE.tsx";
import { courseJsonLd, breadcrumbJsonLd, faqJsonLd } from "@/lib/structuredData";
import { veFAQs } from "@/data/liveVEData";

const title =
  "LevelUp Video Editing Academy | Become the Editor Everyone Wants to Hire";
const description =
  "Join the LevelUp Video Editing Academy — India's most outcome-focused live mentor-led program for video editors. Learn from industry mentors and build a portfolio that hires you.";

const course = courseJsonLd({
  name: "LevelUp Video Editing Academy",
  description,
  path: "/live/ve",
  courseMode: "online",
});

const breadcrumb = breadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Video Editing Academy", path: "/live/ve" },
]);

const faq = faqJsonLd(
  veFAQs.map((f) => ({ question: f.question, answer: f.answer }))
);
---

<BaseLayout
  title={title}
  description={description}
  path="/live/ve"
  ogImage="/og/live-ve.jpg"
  type="course"
  jsonLd={[course, breadcrumb, faq]}
>
  <LiveVE client:idle />
</BaseLayout>
