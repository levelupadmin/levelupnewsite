---
import "@/styles/globals.css";
import Seo from "@/components/Seo.astro";
import { organizationJsonLd, websiteJsonLd } from "@/lib/structuredData";
import { META_PIXEL_ID } from "@/lib/constants";

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: "website" | "article" | "course";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
  bodyClass?: string;
  preloadImage?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  type = "website",
  jsonLd,
  noIndex = false,
  bodyClass = "",
  preloadImage,
} = Astro.props;

const siteJsonLd = [organizationJsonLd, websiteJsonLd];
const allJsonLd = jsonLd
  ? [...siteJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : siteJsonLd;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <link rel="preconnect" href="https://www.clarity.ms" crossorigin />
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
    <link rel="dns-prefetch" href="https://www.facebook.com" />

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      type={type}
      jsonLd={allJsonLd}
      noIndex={noIndex}
    />

    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/sora-var.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/funnel-display-var.woff2" />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.replace(/\.(jpe?g|png)(\?.*)?$/i, ".avif")}
        type="image/avif"
        fetchpriority="high"
      />
    )}

    <style is:inline>
      html, body { margin: 0; padding: 0; }
      body { background-color: hsl(22, 14%, 6%); color: hsl(0, 0%, 93%); }
    </style>

    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "vtl0nas964");
    </script>

    <script
      is:inline
      type="text/javascript"
      define:vars={{ pixelId: META_PIXEL_ID }}
    >
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js"
      );
      window.fbq("init", pixelId);
      window.fbq("track", "PageView");
    </script>

    <!--
      Site-wide UTM forwarding + checkout-click event tracking.
      Runs on EVERY page (homepage, all masterclass landing pages, student
      stories, etc.). When the user clicks any anchor pointing at the LevelUp
      checkout subdomains (study.* / courses.*), this:
        1. Appends incoming utm_source/medium/campaign/content/term + fbclid +
           gclid params from the landing URL (so Tag Mango / TagMango Studio
           attributes the conversion to the right ad).
        2. Tags an extra mc_course param derived from the pathname so the
           checkout page knows which masterclass drove the click.
        3. Fires Meta Pixel `Lead` + `InitiateCheckout` events with
           content_name + content_ids + value + currency.
        4. Fires Microsoft Clarity `initiate_checkout` event for the same.
      Captured UTMs persist in sessionStorage so they survive in-page nav.
    -->
    <script is:inline>
      (function () {
        var CHECKOUT_HOSTS = ["study.leveluplearning.in", "courses.leveluplearning.in"];
        var UTM_KEYS = ["utm_source","utm_medium","utm_campaign","utm_content","utm_term","fbclid","gclid"];
        // Course slug + price + display name keyed by URL pathname
        var COURSE_MAP = {
          "/masterclass/lokesh-kanagaraj":   { slug: "lokesh-kanagaraj",   name: "Lokesh Kanagaraj Masterclass",   price: 1499 },
          "/masterclass/nelson-dilipkumar":  { slug: "nelson-dilipkumar",  name: "Nelson Dilipkumar Masterclass",  price: 2499 },
          "/masterclass/ravi-basrur":        { slug: "ravi-basrur",        name: "Ravi Basrur Music Masterclass",  price: 2499 },
          "/masterclass/anthony-gonsalvez":  { slug: "anthony-gonsalvez",  name: "Anthony Gonsalvez Masterclass",  price: 1499 },
          "/masterclass/drk-kiran":          { slug: "drk-kiran",          name: "DRK Kiran Masterclass",          price: 1499 },
          "/masterclass/g-venket-ram":       { slug: "g-venket-ram",       name: "G Venket Ram Masterclass",       price: 1499 }
        };

        // Capture incoming UTMs (FB ads land users with these), merge with any
        // previously-stored set, and persist for the rest of the session.
        var stored = {};
        try { stored = JSON.parse(sessionStorage.getItem("mc_utm") || "{}"); } catch (e) {}
        var incoming = new URLSearchParams(window.location.search);
        var snap = {};
        for (var i = 0; i < UTM_KEYS.length; i++) {
          var k = UTM_KEYS[i];
          var fromUrl = incoming.get(k);
          if (fromUrl) snap[k] = fromUrl;
          else if (stored[k]) snap[k] = stored[k];
        }
        if (Object.keys(snap).length) {
          try { sessionStorage.setItem("mc_utm", JSON.stringify(snap)); } catch (e) {}
        }

        // ViewContent: deeper than auto-PageView. Builds retargeting audiences
        // for "viewed masterclass X but didn't checkout".
        (function fireViewContent() {
          var path = window.location.pathname.replace(/\/$/, "");
          var c = COURSE_MAP[path];
          if (!c) return;
          try {
            window.fbq && window.fbq("track", "ViewContent", {
              content_type: "product",
              content_name: c.name,
              content_ids: [c.slug],
              content_category: "Masterclass",
              value: c.price,
              currency: "INR"
            });
          } catch (e) {}
          try { window.clarity && window.clarity("set", "viewed_masterclass", c.slug); } catch (e) {}
        })();

        // Click handler — global. Catches every anchor on every page that
        // points at a checkout host. Runs in capture phase so it fires before
        // the browser navigates.
        document.addEventListener("click", function (ev) {
          var t = ev.target.closest && ev.target.closest("a[href]");
          if (!t || !t.href) return;
          var dest;
          try { dest = new URL(t.href, window.location.href); } catch (e) { return; }
          var isCheckout = false;
          for (var j = 0; j < CHECKOUT_HOSTS.length; j++) {
            if (dest.hostname === CHECKOUT_HOSTS[j] || dest.hostname.endsWith("." + CHECKOUT_HOSTS[j])) {
              isCheckout = true; break;
            }
          }
          if (!isCheckout) return;

          // Append UTMs (don't overwrite if already set on the link)
          for (var key in snap) {
            if (snap.hasOwnProperty(key) && !dest.searchParams.has(key)) {
              dest.searchParams.set(key, snap[key]);
            }
          }
          // Tag with current course slug
          var path = window.location.pathname.replace(/\/$/, "");
          var course = COURSE_MAP[path] || { slug: path.split("/").pop() || "homepage", name: "LevelUp Learning", price: 0 };
          if (!dest.searchParams.has("mc_course")) dest.searchParams.set("mc_course", course.slug);
          t.href = dest.toString();

          // Fire conversion events BEFORE navigation
          try {
            window.fbq && window.fbq("track", "Lead", {
              content_name: course.name,
              content_category: "Masterclass",
              value: course.price,
              currency: "INR"
            });
            window.fbq && window.fbq("track", "InitiateCheckout", {
              content_type: "product",
              content_name: course.name,
              content_ids: [course.slug],
              content_category: "Masterclass",
              value: course.price,
              currency: "INR",
              num_items: 1
            });
          } catch (e) {}
          try { window.clarity && window.clarity("set", "initiate_checkout", course.slug + " | INR " + course.price); } catch (e) {}
        }, true);
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
      />
    </noscript>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:px-4 focus:py-2 focus:rounded-md focus:bg-primary focus:text-primary-foreground focus:font-sans focus:text-sm"
    >
      Skip to main content
    </a>

    <slot />

    <a
      href="https://api.whatsapp.com/send?phone=919791520177&text=Hi"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with us on WhatsApp"
      class="fixed bottom-16 right-5 md:bottom-8 md:right-8 z-50 inline-flex items-center gap-2 px-4 py-2.5 md:px-5 md:py-3 rounded-full bg-card/90 backdrop-blur-md border border-border text-foreground font-sans-body text-xs md:text-sm shadow-cinematic hover:border-primary/50 hover:shadow-[0_0_24px_hsl(38_75%_55%/0.15)] transition-all duration-400"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-4 h-4 text-primary"
      >
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
      <span class="hidden sm:inline">Need help?</span>
    </a>
  </body>
</html>
