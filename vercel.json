{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reviews",
      "has": [
        {
          "type": "query",
          "key": "filter",
          "value": "forge"
        }
      ],
      "destination": "/reviews/forge",
      "permanent": true
    },
    {
      "source": "/reviews",
      "has": [
        {
          "type": "query",
          "key": "filter",
          "value": "levelup"
        }
      ],
      "destination": "/reviews/levelup",
      "permanent": true
    },
    {
      "source": "/reviews",
      "has": [
        {
          "type": "query",
          "key": "filter",
          "value": "online-programs"
        }
      ],
      "destination": "/reviews/online-programs",
      "permanent": true
    },
    {
      "source": "/reviews/",
      "has": [
        {
          "type": "query",
          "key": "filter",
          "value": "forge"
        }
      ],
      "destination": "/reviews/forge",
      "permanent": true
    },
    {
      "source": "/reviews/",
      "has": [
        {
          "type": "query",
          "key": "filter",
          "value": "levelup"
        }
      ],
      "destination": "/reviews/levelup",
      "permanent": true
    },
    {
      "source": "/reviews/",
      "has": [
        {
          "type": "query",
          "key": "filter",
          "value": "online-programs"
        }
      ],
      "destination": "/reviews/online-programs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|woff|ttf|otf|webp|avif|jpg|jpeg|png|svg|gif|ico|mp4|m4v|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap-:index.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
